# Benchmark Coder v5.1 — Structured context with program flows + complexity budget
# Three-stage: analyze → implement → test-and-fix
# Uses HashMap regions for file tracking and context tools for analysis artifacts
# v5.1: separate program_flows region (cache consolidation fix in provider),
#        required regions, complexity-aware planning

[agent]
name = "benchmark-coder"
version = "5.1.0"
description = "Three-stage coding agent with structured analysis, program flows, and complexity-aware planning"
entry_stage = "analyze"

[tool_permissions]
read_file      = "allow"
read_files     = "allow"
list_dir       = "allow"
write_file     = "allow"
edit_file      = "allow"
shell           = "allow"
context_write  = "allow"
context_append = "allow"
context_read   = "allow"
context_delete = "allow"
context_list   = "allow"

# ─── File Tracking ────────────────────────────────────────────────────────────
[context.file_tracking]
region = "files"
track_reads = true
track_writes = true
max_file_tokens = 5000

# ─── Stage 1: Analyze ─────────────────────────────────────────────────────────
# Read all specs, build architecture diagram, trace program flows, create plan.
# Uses context_write to populate pinned regions that persist through all stages.
[stages.analyze]
mode = "autonomous"
description = "Read specs, build architecture understanding, trace program flows, create plan"
available_tools = ["read_file", "read_files", "list_dir", "context_write"]
max_iterations = 25
allow_complete = true
next_stage = "implement"

system_prompt = """
You are analyzing a coding task. Your goal is to read all specs and produce THREE
artifacts using the context_write tool. You MUST make three separate context_write
calls — one for each region.

IMPORTANT: When you read_file, the content is automatically stored in your system
prompt under the 'files' section. You can reference files you've already read
without calling read_file again.

STEP-BY-STEP:

1. list_dir to see what spec files exist
2. read_file each spec file

3. context_write region="architecture" — STATIC STRUCTURE:
   - Mermaid component diagram showing modules and their relationships
   - Key interfaces and contracts between components
   - Data models and their fields
   - External dependencies (databases, APIs, config files)

4. context_write region="program_flows" — RUNTIME BEHAVIOR:
   - Trace the primary happy-path flow end-to-end (e.g., "request arrives →
     validate → process → store → respond") with actual function call chain
   - Trace the primary error/failure flow with call chain
   - Trace the test flow: "test runner imports module → instantiates →
     calls method → asserts result" — what does this look like for your design?
   - Identify lifecycle concerns: what starts/stops, what state is shared,
     what cleanup is needed

5. context_write region="plan" — IMPLEMENTATION PLAN:
   - Assess overall complexity: is this a straightforward data pipeline, a
     concurrent system, a stateful service? Match your approach to the actual
     requirements — don't add complexity the spec doesn't demand.
   - Ordered list of files to create, with dependencies
   - For each file: its public interface (function/class signatures)
   - Integration points between files
   - Testing strategy: how will each module be tested in isolation?
   - Constraints: list any simplifying decisions you're making and why
     (e.g., "using sync because the spec has no concurrency requirements"
     or "using async because the spec requires concurrent request handling")

6. Complete the stage

DO NOT read the same file twice. After reading all specs, your NEXT actions must
be the three context_write calls.
"""

[stages.analyze.model]
models = [
  { provider = "anthropic", model = "claude-sonnet-5" },
  { provider = "anthropic", model = "claude-opus-4-8" }
]

[stages.analyze.tool_result_routing]
default_region = "scratch"
persist = true
[stages.analyze.tool_result_routing.tool_overrides]
list_dir = "scratch"

[stages.analyze.transitions.implement]
hint = "Analysis complete — begin implementation"
transform = "custom"
[stages.analyze.transitions.implement.transform_config]
carry = ["architecture", "program_flows", "plan", "files"]
compact = ["conversation"]
clear = ["scratch"]
compact_prompt = "Summarize the analysis phase: key findings, architecture decisions, program flows, and implementation plan."

# ─── Stage 2: Implement ───────────────────────────────────────────────────────
[stages.implement]
mode = "autonomous"
description = "Implement all components following the plan"
available_tools = ["read_file", "write_file", "edit_file", "list_dir", "shell"]
max_iterations = 120
allow_complete = false
next_stage = "test_fix"

system_prompt = """
You are implementing a coding task. Your architecture, program flows, and plan are
in your context — review them before starting.

RULES:
- Follow your plan's build order and public interfaces exactly.
- Match the complexity level you set in your plan. If you decided on a simple
  synchronous approach, build that. If you decided async was necessary, build that.
  Don't escalate complexity mid-implementation.
- File contents are auto-tracked: every write_file/edit_file updates your 'files'
  context region automatically.
- Every module you write must be importable and testable in isolation:
  * No side effects on import (no code that runs at module level except definitions)
  * Constructor/factory dependencies must be injectable (no hard-wired globals
    that prevent instantiation in a test)
  * If a module needs setup/teardown (background tasks, connections), that must
    happen through explicit lifecycle methods, not on import
- Use shell to verify imports work after writing each component.

WORKFLOW:
1. Review your plan and program flows
2. Write requirements.txt first
3. Build each component per the plan using write_file
4. After each component: shell to verify it imports cleanly
5. After all components: shell to verify the test flow from program_flows works
   (import the entry point, instantiate, call with test data)
6. When all files written and imports verified: complete the stage
"""

[stages.implement.model]
models = [
  { provider = "anthropic", model = "claude-sonnet-5" },
  { provider = "anthropic", model = "claude-opus-4-8" }
]

[stages.implement.tool_result_routing]
default_region = "conversation"
persist = true
[stages.implement.tool_result_routing.tool_overrides]
list_dir = "scratch"
shell = "scratch"

[stages.implement.transitions.test_fix]
hint = "Implementation complete — begin testing"
transform = "custom"
[stages.implement.transitions.test_fix.transform_config]
carry = ["architecture", "program_flows", "plan", "files"]
compact = ["conversation"]
clear = ["scratch", "test_results"]
compact_prompt = "Summarize what was implemented: files created, key decisions, any known issues."

# ─── Stage 3: Test and Fix ────────────────────────────────────────────────────
[stages.test_fix]
mode = "autonomous"
description = "Run tests, fix failures, repeat until all pass"
available_tools = ["read_file", "write_file", "edit_file", "list_dir", "shell"]
max_iterations = 80
allow_complete = true

system_prompt = """
You are in the TEST AND FIX phase. All source files have been written.

Your context includes:
- architecture: how components connect
- program_flows: expected runtime behavior and test flow
- plan: the original design decisions and complexity constraints
- files: current content of every file

RULES:
- Start by installing requirements and running the full test suite.
- For each failure: check program_flows to understand expected behavior,
  read the failing test, read the relevant source, fix with edit_file.
- Re-run tests after EACH fix to verify progress.
- If a fix would require changing the fundamental architecture (e.g.,
  sync→async or vice versa), fix the specific issue within the current
  design rather than rewriting. The architecture was chosen deliberately.
- File edits are auto-tracked — your files region always has the latest version.
- Do NOT stop until ALL tests pass.

WORKFLOW:
1. shell: pip3 install -r requirements.txt 2>&1
2. shell: python3 -m pytest tests/ -v --tb=short 2>&1
3. For each failure: understand → fix → re-test
4. Repeat until all tests pass
"""

[stages.test_fix.model]
models = [
  { provider = "anthropic", model = "claude-sonnet-5" },
  { provider = "anthropic", model = "claude-opus-4-8" }
]

[stages.test_fix.tool_result_routing]
default_region = "conversation"
persist = true
[stages.test_fix.tool_result_routing.tool_overrides]
list_dir = "scratch"
shell = "test_results"

# ─── Compaction ───────────────────────────────────────────────────────────────
[compaction]
provider = "anthropic"
model = "claude-sonnet-5"

# ─── Repetition Detection ────────────────────────────────────────────────────
[context.repetition_detection]
max_repeat_calls = 4
max_readonly_streak = 15

# ─── Context Layout ──────────────────────────────────────────────────────────
#
# Pinned (stable, cacheable — provider consolidates cache_control blocks):
#   architecture    — static structure: component diagram, interfaces, data models
#   program_flows   — runtime behavior: happy path, error path, test path traces
#   plan            — implementation plan with complexity budget and constraints
#   task            — the original task description
#
# HashMap (keyed by file path, auto-synced via file tracking):
#   files           — latest version of every file the agent reads/writes
#
# Knowledge (compacting):
#   test_results    — test output, compacted when large
#   test_history    — summarized older test results
#
# Conversation (sliding window with bulk eviction for caching):
#   conversation    — recent messages
#
# Working memory (volatile):
#   scratch         — transient output

[context.regions]
architecture   = { kind = "pinned",          max_tokens = 6000,  required = true, required_message = "Write the architecture analysis via context_write with region='architecture'." }
program_flows  = { kind = "pinned",          max_tokens = 5000,  required = true, required_message = "Write the program flows via context_write with region='program_flows'. Trace the happy path, error path, and test path." }
plan           = { kind = "pinned",          max_tokens = 4000,  required = true, required_message = "Write the implementation plan via context_write with region='plan'. Include complexity assessment and file interfaces." }
task           = { kind = "pinned",          max_tokens = 4000 }
files          = { kind = "hashmap",         max_tokens = 40000, max_entries = 50 }
test_results   = { kind = "compacting",      threshold_tokens = 15000, max_tokens = 25000 }
test_history   = { kind = "compact_history", source_region = "test_results", max_tokens = 5000 }
conversation   = { kind = "sliding_window",  max_items = 80, max_tokens = 50000, strategy = "bulk", overflow = 20 }
scratch        = { kind = "clearable",       max_tokens = 10000 }
