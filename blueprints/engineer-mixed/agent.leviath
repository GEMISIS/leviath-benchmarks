# Engineer v1.0 — Full software engineering pipeline
# 8-stage: analyze → test_design → design → scaffold → implement → validate ↔ troubleshoot → fix/redesign
# Models real engineering workflow: spec → tests → design → build → validate → iterate

[agent]
name = "engineer-mixed"
version = "1.0.0"
description = "Mixed-model engineer: Opus planning, Haiku implementation, Sonnet validation"
entry_stage = "analyze"

[tool_permissions]
read_file      = "allow"
read_files     = "allow"
list_dir       = "allow"
write_file     = "allow"
edit_file      = "allow"
shell          = "allow"
context_write  = "allow"
context_append = "allow"
context_read   = "allow"
context_delete = "allow"
context_list   = "allow"

# ─── File Tracking ────────────────────────────────────────────────────────────
[context.file_tracking]
region = "files"
track_reads = true
track_writes = true
max_file_tokens = 5000

# ═══════════════════════════════════════════════════════════════════════════════
# Stage 1: ANALYZE — Read spec, extract every constraint
# ═══════════════════════════════════════════════════════════════════════════════
[stages.analyze]
mode = "autonomous"
description = "Read all spec files and extract every constraint the spec imposes"
available_tools = ["read_file", "read_files", "list_dir", "context_write"]
max_iterations = 100
allow_complete = false
next_stage = "test_design"

system_prompt = """
You are analyzing a coding task specification. Your job is NOT to design a solution
— it is to EXTRACT every constraint the specification imposes.

STEP-BY-STEP:

1. list_dir to see what spec/config files exist
2. read_file each one

3. context_write region="constraints" — Extract EVERY constraint from the spec:

   FORMAT:
   ## Module Structure
   - [exact quotes or paraphrases about file layout, module paths, naming]

   ## Public Interfaces
   - [every function signature, class name, factory pattern the spec defines]
   - [include parameter types, return types, default behaviors]

   ## Data Contracts
   - [field names, formats, validation rules, ID patterns]
   - [include exact regex patterns, size limits, allowed values]

   ## Configuration
   - [config file formats, paths, what gets loaded from where]
   - [include auth mechanisms: how API keys work, hashing, plaintext vs hashed]

   ## Behavioral Requirements
   - [HTTP status codes for each scenario]
   - [error response formats, header requirements]
   - [rate limits, batch limits, size limits with exact numbers]

   ## Integration Contracts
   - [how components connect: what calls what, data flow]
   - [database schemas, storage formats]
   - [lifecycle: startup, shutdown, cleanup]

   Be EXHAUSTIVE. Every number, every format, every edge case. If the spec says
   "tenant_id must match pattern tn-[a-z]{2}-[a-z]+-\\d{4}", write that exact pattern.
   If it says "create_app() takes no arguments", write that. If it says "API keys
   are bcrypt hashed and auth compares plaintext against hashes", write that.

   This is forensic extraction, not creative design.

4. Complete the stage.

DO NOT design anything. DO NOT make architecture decisions. ONLY extract what
the spec already tells you.
"""

[stages.analyze.model]
models = [
  { provider = "anthropic", model = "claude-opus-4-6" },
  { provider = "anthropic", model = "claude-opus-4-8" }
]

[stages.analyze.tool_result_routing]
default_region = "scratch"
persist = true

[stages.analyze.transitions.test_design]
hint = "Constraints extracted — design tests"
transform = "custom"
[stages.analyze.transitions.test_design.transform_config]
carry = ["constraints", "files"]
compact = ["conversation"]
clear = ["scratch"]
compact_prompt = "Summarize what spec files were read and key findings."

# ═══════════════════════════════════════════════════════════════════════════════
# Stage 2: TEST DESIGN — Write tests from spec BEFORE any architecture
# ═══════════════════════════════════════════════════════════════════════════════
[stages.test_design]
mode = "autonomous"
description = "Write pytest test files based purely on spec constraints — before any architecture exists"
available_tools = ["read_file", "write_file", "list_dir", "shell", "context_write"]
max_iterations = 150
allow_complete = false
next_stage = "design"

system_prompt = """
You are writing tests based on the specification constraints in your context.
NO architecture has been designed yet. You are defining the CONTRACT that any
valid implementation must satisfy.

Your constraints region contains every requirement extracted from the spec.
Write pytest test files that verify these requirements.

RULES:
- Tests must be IMPLEMENTATION-AGNOSTIC — they test the PUBLIC interface only
- Every test imports from `src.` (flat module structure: src/api.py, src/storage.py, etc.)
- The app factory is `from src.api import create_app` — takes NO arguments
- Tests use Flask's test_client: `app.test_client()`
- Write tests for EVERY constraint in your constraints region
- Group tests by concern (auth, validation, pipeline, algorithms, etc.)

WRITE THESE FILES:
1. `requirements.txt` — all dependencies needed (flask, pyyaml, bcrypt, pytest, etc.)
2. `tests/test_contracts.py` — behavioral/integration tests:
   - API auth (bcrypt plaintext comparison)
   - Event ingestion (valid events, invalid events, all error codes)
   - Batch handling
   - Rate limiting
   - Schema validation (every field, format, constraint)
   - Health endpoint, metrics endpoint
   - DLQ endpoints
   - Idempotency
   - Response headers and formats
3. `tests/test_algorithms.py` — algorithm/unit tests:
   - Storage key format
   - Backoff calculation
   - Circuit breaker state machine
   - Audit hash chain
   - Metrics/percentile calculations
   - GDPR transforms
4. `tests/conftest.py` — shared fixtures (app instance, test client, etc.)

After writing each test file, run: `shell: python3 -c "import ast; ast.parse(open('tests/test_contracts.py').read()); print('syntax OK')"`
to verify syntax.

context_write region="test_summary" — Brief summary of what tests cover and total test count.

IMPORTANT: These tests define the contract. The architecture in the next stage
MUST satisfy these tests. Write them to be thorough but fair — test what the spec
requires, not implementation details you're guessing about.
"""

[stages.test_design.model]
models = [
  { provider = "anthropic", model = "claude-opus-4-6" },
  { provider = "anthropic", model = "claude-opus-4-8" }
]

[stages.test_design.tool_result_routing]
default_region = "conversation"
persist = true
[stages.test_design.tool_result_routing.tool_overrides]
list_dir = "scratch"
shell = "scratch"

[stages.test_design.transitions.design]
hint = "Tests written — design the architecture"
transform = "custom"
[stages.test_design.transitions.design.transform_config]
carry = ["constraints", "test_summary", "files"]
compact = ["conversation"]
clear = ["scratch"]
compact_prompt = "Summarize tests written: files, test count, key contracts tested."

# ═══════════════════════════════════════════════════════════════════════════════
# Stage 3: DESIGN — Architecture decisions informed by constraints AND tests
# ═══════════════════════════════════════════════════════════════════════════════
[stages.design]
mode = "autonomous"
description = "Design architecture to satisfy constraints and pass tests"
available_tools = ["read_file", "list_dir", "context_write"]
max_iterations = 100
max_revisits = 2
allow_complete = false
next_stage = "scaffold"

system_prompt = """
You are designing the architecture for a system that must pass the tests already
written in the tests/ directory AND satisfy all constraints.

Your context includes:
- constraints: every requirement from the spec
- test_summary: what the tests verify
- files: the actual test files (read them to understand exact expectations)
- diagnosis (on REDESIGN only): what failed and why in the previous attempt

STEP-BY-STEP:

1. Read the test files to understand exactly what they import and assert
2. If this is a REDESIGN (diagnosis region exists): read the diagnosis carefully.
   Identify what specific architectural decision caused the failure.

3. context_write region="architecture" — Your design:

   ## Module Layout
   - Exact file paths (src/api.py, src/storage.py, etc.)
   - What each module exports

   ## Class & Function Signatures
   - Every public class, its constructor, its key methods
   - Exact parameter names and types matching what tests expect

   ## Data Flow
   - How a request flows through the system
   - What calls what, in what order

   ## Key Design Decisions
   - Sync vs async (and why)
   - Database approach (SQLite, in-memory, etc.)
   - Auth implementation (bcrypt comparison approach)
   - How config is loaded and shared

   ## Changes from Previous Design (REDESIGN only)
   - What changed and why
   - How this addresses the diagnosed failures

Your architecture MUST be compatible with the tests. If tests import
`from src.api import create_app` and call `create_app()` with no args,
your design must include a zero-argument create_app factory.

4. Complete the stage.
"""

[stages.design.model]
models = [
  { provider = "anthropic", model = "claude-opus-4-6" },
  { provider = "anthropic", model = "claude-opus-4-8" }
]

[stages.design.tool_result_routing]
default_region = "scratch"
persist = true

[stages.design.transitions.scaffold]
hint = "Architecture designed — write skeleton files"
transform = "custom"
[stages.design.transitions.scaffold.transform_config]
carry = ["constraints", "test_summary", "architecture", "diagnosis", "files"]
compact = ["conversation"]
clear = ["scratch"]
compact_prompt = "Summarize the architecture design and key decisions."

# ═══════════════════════════════════════════════════════════════════════════════
# Stage 4: SCAFFOLD — Write skeleton files (stubs, interfaces, no logic)
# ═══════════════════════════════════════════════════════════════════════════════
[stages.scaffold]
mode = "autonomous"
description = "Write all source files as stubs/interfaces matching the architecture"
available_tools = ["read_file", "write_file", "list_dir", "shell"]
max_iterations = 150
max_revisits = 2
allow_complete = false
next_stage = "implement"

system_prompt = """
You are writing skeleton files — stubs and interfaces — for every source module.
Your architecture region defines exactly what to create.

RULES:
- Write EVERY file defined in the architecture
- Each file has: imports, class definitions, method signatures, docstrings
- Method bodies should be: `raise NotImplementedError("TODO")` or `pass`
- Exception: __init__.py files, requirements.txt, and config-loading boilerplate
  can be fully implemented (they're structural, not logic)
- Factory functions (create_app, etc.) should have the FULL setup scaffolding
  (route registration, middleware, etc.) but handler bodies are stubs
- After writing each file: `shell: python3 -c "from src.MODULE import *; print('OK')"`

WORKFLOW:
1. Write requirements.txt (should already exist but update if needed)
2. Write src/__init__.py
3. Write each module as stubs per the architecture
4. Verify all imports work
5. Complete the stage

The goal: after this stage, every file exists, every import works, every class
and function is defined. The implement stage just fills in the method bodies.
"""

[stages.scaffold.model]
models = [
  { provider = "anthropic", model = "claude-haiku-4-5" }
]

[stages.scaffold.tool_result_routing]
default_region = "conversation"
persist = true
[stages.scaffold.tool_result_routing.tool_overrides]
list_dir = "scratch"
shell = "scratch"

[stages.scaffold.transitions.implement]
hint = "Skeleton written — implement the logic"
transform = "custom"
[stages.scaffold.transitions.implement.transform_config]
carry = ["constraints", "test_summary", "architecture", "files"]
compact = ["conversation"]
clear = ["scratch", "diagnosis"]
compact_prompt = "Summarize skeleton files created and any import issues resolved."

# ═══════════════════════════════════════════════════════════════════════════════
# Stage 5: IMPLEMENT — Fill in the stubs with real logic
# ═══════════════════════════════════════════════════════════════════════════════
[stages.implement]
mode = "autonomous"
description = "Fill in skeleton stubs with real implementation logic"
available_tools = ["read_file", "edit_file", "list_dir", "shell"]
max_iterations = 300
max_revisits = 2
allow_complete = false
next_stage = "validate"

system_prompt = """
You are implementing the logic for a system whose skeleton is already written.
Every file exists. Every class and method is defined. You just need to fill in
the method bodies.

Your context includes:
- constraints: requirements to satisfy
- architecture: design decisions to follow
- files: current skeleton code

RULES:
- Use edit_file ONLY — do not use write_file. The file structure is locked.
- Replace `raise NotImplementedError("TODO")` and `pass` stubs with real logic
- Follow the architecture's design decisions exactly
- After implementing each module, verify it still imports:
  `shell: python3 -c "from src.MODULE import CLASS; print('OK')"`
- Match the complexity level in the architecture. Don't over-engineer.

WORKFLOW:
1. Review architecture and constraints
2. Implement modules in dependency order (leaf modules first):
   a. Read the skeleton file
   b. edit_file to replace stubs with real logic
   c. Verify imports still work
3. After all modules implemented:
   a. Quick smoke test: `python3 -c "from src.api import create_app; app = create_app(); print('OK')"`
4. Complete the stage

Do NOT change file structure, class names, method signatures, or module layout.
Only fill in method bodies.
"""

[stages.implement.model]
models = [
  { provider = "anthropic", model = "claude-haiku-4-5" }
]

[stages.implement.tool_result_routing]
default_region = "conversation"
persist = true
[stages.implement.tool_result_routing.tool_overrides]
list_dir = "scratch"
shell = "scratch"

[stages.implement.transitions.validate]
hint = "Implementation complete — run tests"
transform = "custom"
[stages.implement.transitions.validate.transform_config]
carry = ["constraints", "test_summary", "architecture", "files"]
compact = ["conversation"]
clear = ["scratch"]
compact_prompt = "Summarize: modules implemented, any issues encountered, smoke test results."

# ═══════════════════════════════════════════════════════════════════════════════
# Stage 6: VALIDATE — Run tests, report results
# ═══════════════════════════════════════════════════════════════════════════════
[stages.validate]
mode = "autonomous"
description = "Run all tests and report results"
available_tools = ["shell", "read_file", "list_dir", "context_write"]
max_iterations = 100
max_revisits = 3
allow_complete = true
next_stage = "troubleshoot"

system_prompt = """
You are running the test suite to validate the implementation.

WORKFLOW:
1. shell: pip3 install -r requirements.txt 2>&1 | tail -5
2. shell: python3 -m pytest tests/ -v --tb=short 2>&1
3. context_write region="test_results" — Record:
   - Total passed / failed / skipped / error
   - List of each failing test with the failure reason (1 line each)
   - List of each passing test (just names)

4. If ALL tests pass: complete the stage (the run is done!)
5. If any tests FAIL: transition to troubleshoot

Do NOT edit any files. Do NOT try to fix anything. Just run and report.
"""

[stages.validate.model]
models = [
  { provider = "anthropic", model = "claude-sonnet-5" },
  { provider = "anthropic", model = "claude-opus-4-8" }
]

[stages.validate.tool_result_routing]
default_region = "scratch"
persist = true

[stages.validate.transitions.troubleshoot]
hint = "Tests failed — diagnose the issues"
transform = "custom"
[stages.validate.transitions.troubleshoot.transform_config]
carry = ["constraints", "test_summary", "architecture", "test_results", "files"]
compact = ["conversation"]
clear = ["scratch"]
compact_prompt = "Summarize test run: what passed, what failed, error messages."

# ═══════════════════════════════════════════════════════════════════════════════
# Stage 7: TROUBLESHOOT — Diagnose failures, choose fix strategy
# ═══════════════════════════════════════════════════════════════════════════════
[stages.troubleshoot]
mode = "autonomous"
description = "Diagnose test failures and decide: quick fix or redesign"
available_tools = ["read_file", "list_dir", "shell", "context_write"]
max_iterations = 100
allow_complete = false

system_prompt = """
You are diagnosing test failures. Your test_results region shows what failed.

STEP-BY-STEP:

1. For each failing test:
   a. Read the test to understand what it expects
   b. Read the relevant source file
   c. Run the test in isolation if needed: `shell: python3 -m pytest tests/FILE::CLASS::METHOD -v --tb=long 2>&1`
   d. Identify the ROOT CAUSE (not just the symptom)

2. context_write region="diagnosis" — Write your diagnosis:

   ## Failure Analysis
   For each failing test:
   - Test: [name]
   - Expected: [what the test checks]
   - Actual: [what happened]
   - Root cause: [why]
   - Fix type: QUICK_FIX or REDESIGN
   - Fix description: [what needs to change]

   ## Overall Assessment
   - Total failures: N
   - Quick fixes: N (minor logic errors, wrong values, missing fields)
   - Redesigns: N (wrong module structure, wrong patterns, missing components)

   ## Recommendation
   If ALL fixes are QUICK_FIX: recommend quick_fix path
   If ANY fix requires REDESIGN: recommend redesign path
   (A redesign is needed when: wrong module path, wrong class hierarchy,
    missing factory pattern, wrong auth approach, structural mismatch)

3. Transition to either quick_fix or redesign based on your recommendation.

Do NOT edit any files. ONLY diagnose and recommend.
"""

[stages.troubleshoot.model]
models = [
  { provider = "anthropic", model = "claude-sonnet-5" },
  { provider = "anthropic", model = "claude-opus-4-8" }
]

[stages.troubleshoot.tool_result_routing]
default_region = "scratch"
persist = true

[stages.troubleshoot.transitions.quick_fix]
hint = "Issues are minor — apply quick fixes"
transform = "custom"
[stages.troubleshoot.transitions.quick_fix.transform_config]
carry = ["constraints", "test_summary", "architecture", "test_results", "diagnosis", "files"]
compact = ["conversation"]
clear = ["scratch"]
compact_prompt = "Summarize diagnosis: what failed and recommended fixes."

[stages.troubleshoot.transitions.redesign]
hint = "Structural issues found — redesign needed"
transform = "custom"
[stages.troubleshoot.transitions.redesign.transform_config]
carry = ["constraints", "test_summary", "architecture", "test_results", "diagnosis", "files"]
compact = ["conversation"]
clear = ["scratch"]
compact_prompt = "Summarize diagnosis: structural issues requiring redesign."

# ═══════════════════════════════════════════════════════════════════════════════
# Stage 8: QUICK FIX — Minor edits to fix failing tests
# ═══════════════════════════════════════════════════════════════════════════════
[stages.quick_fix]
mode = "autonomous"
description = "Apply minimal edits to fix diagnosed issues"
available_tools = ["read_file", "edit_file", "shell", "list_dir"]
max_iterations = 200
allow_complete = true
next_stage = "validate"

system_prompt = """
You are applying quick fixes based on the diagnosis in your context.

RULES:
- ONLY fix what the diagnosis identifies. Do not make other changes.
- Use edit_file only — do NOT create new files.
- After each fix, re-run the specific failing test:
  `shell: python3 -m pytest tests/FILE::CLASS::METHOD -v --tb=short 2>&1`
- Be surgical: one edit per issue, verify, move to next.
- Do NOT change the architecture, module structure, or class hierarchy.

WORKFLOW:
1. Read the diagnosis
2. For each QUICK_FIX item:
   a. Read the relevant source file
   b. Apply the minimal edit
   c. Verify the specific test passes
3. Complete the stage (returns to validate for full test suite run)
"""

[stages.quick_fix.model]
models = [
  { provider = "anthropic", model = "claude-sonnet-5" },
  { provider = "anthropic", model = "claude-opus-4-8" }
]

[stages.quick_fix.tool_result_routing]
default_region = "conversation"
persist = true
[stages.quick_fix.tool_result_routing.tool_overrides]
shell = "scratch"

[stages.quick_fix.transitions.validate]
hint = "Fixes applied — re-run full test suite"
transform = "custom"
[stages.quick_fix.transitions.validate.transform_config]
carry = ["constraints", "test_summary", "architecture", "files"]
compact = ["conversation"]
clear = ["scratch", "test_results", "diagnosis"]
compact_prompt = "Summarize fixes applied and individual test results."

# ═══════════════════════════════════════════════════════════════════════════════
# Stage 9: REDESIGN — Back to design with failure context
# ═══════════════════════════════════════════════════════════════════════════════
# This transitions back to the design stage, which has max_revisits = 2.
# The diagnosis region carries forward so design knows what went wrong.
[stages.redesign]
mode = "autonomous"
description = "Prepare for redesign — transition back to design stage with diagnosis"
available_tools = ["read_file", "context_write", "context_append"]
max_iterations = 50
allow_complete = true
next_stage = "design"

system_prompt = """
You are preparing for a redesign. The diagnosis region explains what structural
issues need to be fixed.

STEP-BY-STEP:
1. Review the diagnosis
2. context_append region="diagnosis" — Add a REDESIGN DIRECTIVE:
   - What specific architectural changes are needed
   - What must NOT change (things that are working)
   - Priority order of changes

3. Complete the stage to transition back to the design stage.

Keep it brief. The design stage will read the full diagnosis.
"""

[stages.redesign.model]
models = [
  { provider = "anthropic", model = "claude-sonnet-5" },
  { provider = "anthropic", model = "claude-opus-4-8" }
]

[stages.redesign.tool_result_routing]
default_region = "scratch"
persist = true

[stages.redesign.transitions.design]
hint = "Redesign prepared — return to design stage"
transform = "custom"
[stages.redesign.transitions.design.transform_config]
carry = ["constraints", "test_summary", "diagnosis", "test_results", "files"]
compact = ["conversation"]
clear = ["scratch", "architecture"]
compact_prompt = "Summarize what needs to change in the redesign."

# ─── Compaction ───────────────────────────────────────────────────────────────
[compaction]
provider = "anthropic"
model = "claude-sonnet-5"

# ─── Repetition Detection ────────────────────────────────────────────────────
[context.repetition_detection]
max_repeat_calls = 4
max_readonly_streak = 15

# ─── Context Layout ──────────────────────────────────────────────────────────
[context.regions]
constraints    = { kind = "pinned",          max_tokens = 8000,  required = true, required_message = "Write the extracted constraints via context_write with region='constraints'." }
test_summary   = { kind = "pinned",          max_tokens = 3000,  required = true, required_message = "Write the test summary via context_write with region='test_summary'." }
architecture   = { kind = "pinned",          max_tokens = 6000 }
diagnosis      = { kind = "pinned",          max_tokens = 5000 }
test_results   = { kind = "pinned",          max_tokens = 5000 }
task           = { kind = "pinned",          max_tokens = 4000 }
files          = { kind = "hashmap",         max_tokens = 40000, max_entries = 50 }
conversation   = { kind = "sliding_window",  max_items = 80, max_tokens = 50000, strategy = "bulk", overflow = 20 }
scratch        = { kind = "clearable",       max_tokens = 10000 }
