# Engineer v3.0 — Optimized software engineering pipeline
#
# Changes from v2.1:
#   1. Merged analyze + design into single analyze_and_design stage
#   2. Generic prompts (no language-specific instructions)
#   3. No redundant file reads (model told files region has current code)
#   4. Batch verification (one check at end, not per-file)
#   5. Per-stage context filtering (no test_summary in implement, etc.)
#   6. Encourage batched tool calls where possible
#   7. Clear spec/test files from files region before implement
#
# Pipeline: analyze_and_design → test_design → scaffold → implement
#           → validate ↔ troubleshoot → quick_fix / redesign

[agent]
name = "engineer-v3"
version = "3.0.0"
description = "Optimized engineering pipeline: fewer stages, batched operations, minimal redundancy"
entry_stage = "analyze_and_design"

[tool_permissions]
read_file      = "allow"
read_files     = "allow"
list_dir       = "allow"
write_file     = "allow"
edit_file      = "allow"
shell          = "allow"
context_write  = "allow"
context_append = "allow"
context_read   = "allow"
context_delete = "allow"
context_list   = "allow"

# ─── File Tracking ────────────────────────────────────────────────────────────
[context.file_tracking]
region = "files"
track_reads = true
track_writes = true
max_file_tokens = 5000

# ═══════════════════════════════════════════════════════════════════════════════
# Stage 1: ANALYZE AND DESIGN — Read specs, extract constraints, design arch
# ═══════════════════════════════════════════════════════════════════════════════
# Merged from separate analyze + design stages. Both are read-only planning
# that can happen in one context without a transition.
[stages.analyze_and_design]
mode = "autonomous"
description = "Read all spec files, extract every constraint, then design the architecture"
available_tools = ["read_file", "read_files", "list_dir", "context_write"]
max_iterations = 100
max_revisits = 2
allow_complete = false
next_stage = "test_design"

system_prompt = """
You are analyzing a specification and designing a system architecture.
This stage has TWO phases — do them in order.

EFFICIENCY: You can call multiple tools in a single response when they are
independent (e.g., read multiple files at once using read_files).

## Phase 1: Extract Constraints

1. Use list_dir to discover spec and config files
2. Use read_files to read ALL spec/config files at once (batch them)
3. context_write region="constraints" — Extract EVERY constraint in ONE write:

   ## Module Structure
   - File layout, module paths, naming conventions

   ## Public Interfaces
   - Every function signature, class, factory pattern (with param types and returns)

   ## Data Contracts
   - Field names, formats, validation rules, ID patterns, regex, size limits

   ## Configuration
   - Config file formats, paths, runtime loading requirements
   - Auth mechanisms (hashing, plaintext comparison, etc.)

   ## Behavioral Requirements
   - Status codes per scenario, error formats, headers
   - Rate limits, batch limits, size limits (exact numbers)

   ## Algorithm Contracts
   - Exact function signatures and expected behavior
   - Mathematical formulas, state machines, hash algorithms

   ## Integration Contracts
   - Component connections, data flow, database schemas, lifecycle

   Be EXHAUSTIVE. Every number, format, edge case. This is forensic extraction.

## Phase 2: Design Architecture

4. context_write region="architecture" — Design the system:

   ## Module Layout
   - Exact file paths and what each module exports

   ## Class & Function Signatures
   - Every public class, constructor, key methods (matching spec exactly)

   ## Data Flow
   - Request flow through the system, what calls what

   ## Key Design Decisions
   - Sync vs async, database approach, auth implementation, config loading

   The architecture MUST satisfy all extracted constraints.

5. Complete the stage.
"""

[stages.analyze_and_design.model]
models = [
  { provider = "anthropic", model = "claude-sonnet-5" },
  { provider = "anthropic", model = "claude-opus-4-8" }
]

[stages.analyze_and_design.tool_result_routing]
default_region = "scratch"
persist = true

[stages.analyze_and_design.transitions.test_design]
hint = "Constraints extracted and architecture designed — write tests"
transform = "custom"
[stages.analyze_and_design.transitions.test_design.transform_config]
carry = ["constraints", "architecture", "files"]
compact = ["conversation"]
clear = ["scratch"]
compact_prompt = "Summarize: spec files read, key constraints, architecture decisions."

# ═══════════════════════════════════════════════════════════════════════════════
# Stage 2: TEST DESIGN — Write tests from spec constraints
# ═══════════════════════════════════════════════════════════════════════════════
[stages.test_design]
mode = "autonomous"
description = "Write test files based on spec constraints — before any implementation"
available_tools = ["read_file", "write_file", "list_dir", "shell", "context_write"]
max_iterations = 100
allow_complete = false
next_stage = "scaffold"

system_prompt = """
You are writing tests based on the specification constraints. NO implementation
exists yet. You are defining the CONTRACT that any valid implementation must pass.

EFFICIENCY: Batch independent operations. Write multiple files, then verify
syntax once at the end — not after each file.

Your constraints region contains every requirement. Write test files that verify
these requirements.

RULES:
- Tests must be IMPLEMENTATION-AGNOSTIC — test the PUBLIC interface only
- Write tests for EVERY constraint in your constraints region
- Group tests by concern (behavioral/integration vs algorithmic/unit)

WORKFLOW:
1. Write a dependency file listing required packages
2. Write test files (conftest/fixtures, behavioral tests, algorithm tests)
3. After writing ALL files, do ONE syntax verification pass
4. context_write region="test_summary" — Brief summary: test count, what's covered
5. Complete the stage
"""

[stages.test_design.model]
models = [
  { provider = "anthropic", model = "claude-sonnet-5" },
  { provider = "anthropic", model = "claude-opus-4-8" }
]

[stages.test_design.tool_result_routing]
default_region = "conversation"
persist = true
[stages.test_design.tool_result_routing.tool_overrides]
list_dir = "scratch"
shell = "scratch"

[stages.test_design.transitions.scaffold]
hint = "Tests written — write skeleton source files"
transform = "custom"
[stages.test_design.transitions.scaffold.transform_config]
carry = ["constraints", "test_summary", "architecture", "files"]
compact = ["conversation"]
clear = ["scratch"]
compact_prompt = "Summarize tests written: files, test count, key contracts tested."

# ═══════════════════════════════════════════════════════════════════════════════
# Stage 3: SCAFFOLD — Write skeleton files (stubs, interfaces, no logic)
# ═══════════════════════════════════════════════════════════════════════════════
[stages.scaffold]
mode = "autonomous"
description = "Write all source files as stubs/interfaces matching the architecture"
available_tools = ["read_file", "write_file", "list_dir", "shell"]
max_iterations = 100
max_revisits = 2
allow_complete = false
next_stage = "implement"

system_prompt = """
You are writing skeleton files — stubs and interfaces — for every source module
defined in the architecture.

EFFICIENCY: Write multiple files per response. Only verify imports ONCE at the
end, not after each file.

RULES:
- Write EVERY file defined in the architecture
- Each file has: imports, class definitions, method signatures, docstrings
- Method bodies should be stubs (raise NotImplementedError or equivalent)
- Exception: package init files, dependency files, and config-loading boilerplate
  can be fully implemented (they're structural, not logic)
- Factory/entry point functions should have FULL setup scaffolding but handler
  bodies are stubs

WORKFLOW:
1. Write dependency/package files
2. Write all source module skeletons (batch writes where possible)
3. ONE verification at the end: check that all modules import correctly
4. Complete the stage
"""

[stages.scaffold.model]
models = [
  { provider = "anthropic", model = "claude-sonnet-5" },
  { provider = "anthropic", model = "claude-opus-4-8" }
]

[stages.scaffold.tool_result_routing]
default_region = "conversation"
persist = true
[stages.scaffold.tool_result_routing.tool_overrides]
list_dir = "scratch"
shell = "scratch"

[stages.scaffold.transitions.implement]
hint = "Skeleton written — implement the logic"
transform = "custom"
[stages.scaffold.transitions.implement.transform_config]
carry = ["constraints", "architecture", "files"]
compact = ["conversation"]
clear = ["scratch", "diagnosis", "test_summary"]
compact_prompt = "Summarize skeleton files created and any import issues resolved."

# ═══════════════════════════════════════════════════════════════════════════════
# Stage 4: IMPLEMENT — Fill in the stubs with real logic
# ═══════════════════════════════════════════════════════════════════════════════
# KEY OPTIMIZATIONS:
# - No test_summary (prevents test-gaming, implements from spec)
# - Files region already has all source code — DO NOT re-read files
# - Batch edits, verify once at end
[stages.implement]
mode = "autonomous"
description = "Fill in skeleton stubs with real implementation logic"
available_tools = ["edit_file", "read_file", "list_dir", "shell"]
max_iterations = 200
max_revisits = 2
allow_complete = false
next_stage = "validate"

system_prompt = """
You are implementing the logic for a system whose skeleton is already written.
Every file exists with stub method bodies. Fill them in with real logic.

IMPORTANT — YOUR FILES REGION ALREADY CONTAINS ALL SOURCE CODE. The files
context region has the current content of every file. Do NOT use read_file to
read files that are already visible in your files region — just use edit_file
directly. Only use read_file for files NOT in your context (e.g., config files
you need to reference).

EFFICIENCY: Batch multiple edit_file calls in a single response when editing
independent files. Only run verification ONCE after all edits are done, not
after each individual file.

RULES:
- Use edit_file to replace stubs with real logic
- Follow the architecture's design decisions exactly
- Follow the constraints exactly — every number, format, threshold must match
- Do NOT change file structure, class names, or method signatures

WORKFLOW:
1. Review architecture and constraints in your context
2. Edit modules in dependency order (leaf dependencies first)
   - Batch edits for independent modules in the same response
3. After ALL modules are implemented, run ONE smoke test to verify
   the entry point works (e.g., the main module imports and initializes)
4. Complete the stage
"""

[stages.implement.model]
models = [
  { provider = "anthropic", model = "claude-sonnet-5" },
  { provider = "anthropic", model = "claude-opus-4-8" }
]

[stages.implement.tool_result_routing]
default_region = "conversation"
persist = true
[stages.implement.tool_result_routing.tool_overrides]
list_dir = "scratch"
shell = "scratch"

[stages.implement.transitions.validate]
hint = "Implementation complete — run tests"
transform = "custom"
[stages.implement.transitions.validate.transform_config]
carry = ["constraints", "architecture", "files"]
compact = ["conversation"]
clear = ["scratch"]
compact_prompt = "Summarize: modules implemented, any issues encountered, smoke test results."

# ═══════════════════════════════════════════════════════════════════════════════
# Stage 5: VALIDATE — Run tests, report results
# ═══════════════════════════════════════════════════════════════════════════════
[stages.validate]
mode = "autonomous"
description = "Run all tests and report results"
available_tools = ["shell", "read_file", "list_dir", "context_write"]
max_iterations = 50
max_revisits = 3
allow_complete = true
next_stage = "troubleshoot"

system_prompt = """
You are running the test suite to validate the implementation.

WORKFLOW:
1. Install dependencies if not already installed
2. Run the full test suite with verbose output
3. context_write region="test_results" — Record:
   - Total passed / failed / skipped / error
   - Each failing test with the failure reason (1 line each)
   - Each passing test (just names)

4. If ALL tests pass: complete the stage (the run is done!)
5. If any tests FAIL: transition to troubleshoot

Do NOT edit any files. Do NOT try to fix anything. Just run and report.
"""

[stages.validate.model]
models = [
  { provider = "anthropic", model = "claude-sonnet-5" },
  { provider = "anthropic", model = "claude-opus-4-8" }
]

[stages.validate.tool_result_routing]
default_region = "scratch"
persist = true

[stages.validate.transitions.troubleshoot]
hint = "Tests failed — diagnose the issues"
transform = "custom"
[stages.validate.transitions.troubleshoot.transform_config]
carry = ["test_summary", "architecture", "test_results", "files"]
compact = ["conversation"]
clear = ["scratch"]
compact_prompt = "Summarize test run: what passed, what failed, error messages."

# ═══════════════════════════════════════════════════════════════════════════════
# Stage 6: TROUBLESHOOT — Diagnose failures, choose fix strategy
# ═══════════════════════════════════════════════════════════════════════════════
[stages.troubleshoot]
mode = "autonomous"
description = "Diagnose test failures and decide: quick fix or redesign"
available_tools = ["read_file", "list_dir", "shell", "context_write"]
max_iterations = 100
allow_complete = false

system_prompt = """
You are diagnosing test failures. Your test_results region shows what failed.

EFFICIENCY: Batch read_file calls for multiple test/source files in one response.

For each failing test:
1. Read the test AND the relevant source file (batch these reads)
2. Run the test in isolation if needed for detailed output
3. Identify the ROOT CAUSE (not just the symptom)

context_write region="diagnosis" — Write your diagnosis:

## Failure Analysis
For each failing test:
- Test: [name]
- Expected: [what the test checks]
- Actual: [what happened]
- Root cause: [why]
- Fix type: QUICK_FIX or REDESIGN
- Fix description: [what needs to change]

## Recommendation
- If ALL fixes are QUICK_FIX: transition to quick_fix
- If ANY fix requires REDESIGN: transition to redesign
  (Redesign = wrong module structure, missing patterns, structural mismatch)

Do NOT edit any files. ONLY diagnose and recommend.
"""

[stages.troubleshoot.model]
models = [
  { provider = "anthropic", model = "claude-sonnet-5" },
  { provider = "anthropic", model = "claude-opus-4-8" }
]

[stages.troubleshoot.tool_result_routing]
default_region = "scratch"
persist = true

[stages.troubleshoot.transitions.quick_fix]
hint = "Issues are minor — apply quick fixes"
transform = "custom"
[stages.troubleshoot.transitions.quick_fix.transform_config]
carry = ["constraints", "test_results", "diagnosis", "files"]
compact = ["conversation"]
clear = ["scratch", "test_summary", "architecture"]
compact_prompt = "Summarize diagnosis: what failed and recommended fixes."

[stages.troubleshoot.transitions.redesign]
hint = "Structural issues found — redesign needed"
transform = "custom"
[stages.troubleshoot.transitions.redesign.transform_config]
carry = ["constraints", "test_summary", "architecture", "test_results", "diagnosis", "files"]
compact = ["conversation"]
clear = ["scratch"]
compact_prompt = "Summarize diagnosis: structural issues requiring redesign."

# ═══════════════════════════════════════════════════════════════════════════════
# Stage 7: QUICK FIX — Minor edits to fix failing tests
# ═══════════════════════════════════════════════════════════════════════════════
# Focused context: constraints + diagnosis + test_results + files only
[stages.quick_fix]
mode = "autonomous"
description = "Apply minimal edits to fix diagnosed issues"
available_tools = ["read_file", "edit_file", "shell", "list_dir"]
max_iterations = 150
allow_complete = true
next_stage = "validate"

system_prompt = """
You are applying fixes based on the diagnosis in your context.

IMPORTANT: Your files region already has the current source code. Do NOT
re-read files that are visible in your context — just edit_file directly.

EFFICIENCY: If multiple fixes are in different files, batch the edit_file
calls in one response. Verify by running the specific failing tests after
each batch of edits.

RULES:
- ONLY fix what the diagnosis identifies
- Use edit_file only — do NOT create new files
- Be surgical: minimal edits per issue
- Do NOT change architecture, module structure, or class hierarchy

WORKFLOW:
1. Read the diagnosis
2. Apply fixes (batch independent edits)
3. Verify each fixed test passes
4. Complete the stage (returns to validate for full suite run)
"""

[stages.quick_fix.model]
models = [
  { provider = "anthropic", model = "claude-sonnet-5" },
  { provider = "anthropic", model = "claude-opus-4-8" }
]

[stages.quick_fix.tool_result_routing]
default_region = "conversation"
persist = true
[stages.quick_fix.tool_result_routing.tool_overrides]
shell = "scratch"

[stages.quick_fix.transitions.validate]
hint = "Fixes applied — re-run full test suite"
transform = "custom"
[stages.quick_fix.transitions.validate.transform_config]
carry = ["constraints", "test_summary", "architecture", "files"]
compact = ["conversation"]
clear = ["scratch", "test_results", "diagnosis"]
compact_prompt = "Summarize fixes applied and individual test results."

# ═══════════════════════════════════════════════════════════════════════════════
# Stage 8: REDESIGN — Back to analyze_and_design with failure context
# ═══════════════════════════════════════════════════════════════════════════════
[stages.redesign]
mode = "autonomous"
description = "Prepare for redesign — transition back to design with diagnosis"
available_tools = ["read_file", "context_write", "context_append"]
max_iterations = 30
allow_complete = true
next_stage = "analyze_and_design"

system_prompt = """
You are preparing for a redesign. The diagnosis region explains what structural
issues need to be fixed.

1. Review the diagnosis
2. context_append region="diagnosis" — Add a REDESIGN DIRECTIVE:
   - What specific architectural changes are needed
   - What must NOT change (things that are working)
   - Priority order of changes

3. Complete the stage to return to design.
"""

[stages.redesign.model]
models = [
  { provider = "anthropic", model = "claude-sonnet-5" },
  { provider = "anthropic", model = "claude-opus-4-8" }
]

[stages.redesign.tool_result_routing]
default_region = "scratch"
persist = true

[stages.redesign.transitions.analyze_and_design]
hint = "Redesign prepared — return to design stage"
transform = "custom"
[stages.redesign.transitions.analyze_and_design.transform_config]
carry = ["constraints", "test_summary", "diagnosis", "test_results", "files"]
compact = ["conversation"]
clear = ["scratch", "architecture"]
compact_prompt = "Summarize what needs to change in the redesign."

# ─── Compaction ───────────────────────────────────────────────────────────────
[compaction]
provider = "anthropic"
model = "claude-sonnet-5"

# ─── Repetition Detection ────────────────────────────────────────────────────
[context.repetition_detection]
max_repeat_calls = 4
max_readonly_streak = 15

# ─── Context Layout ──────────────────────────────────────────────────────────
[context.regions]
constraints    = { kind = "pinned",          max_tokens = 8000,  required = true, required_message = "Write the extracted constraints via context_write with region='constraints'." }
test_summary   = { kind = "pinned",          max_tokens = 3000,  required = true, required_message = "Write the test summary via context_write with region='test_summary'." }
architecture   = { kind = "pinned",          max_tokens = 6000 }
diagnosis      = { kind = "pinned",          max_tokens = 5000 }
test_results   = { kind = "pinned",          max_tokens = 5000 }
task           = { kind = "pinned",          max_tokens = 4000 }
files          = { kind = "hashmap",         max_tokens = 40000, max_entries = 50 }
conversation   = { kind = "sliding_window",  max_items = 80, max_tokens = 50000, strategy = "bulk", overflow = 20 }
scratch        = { kind = "clearable",       max_tokens = 10000 }
