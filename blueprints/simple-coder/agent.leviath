# Simple coding agent blueprint for benchmarking
# This is a minimal single-stage agent for fair comparison with flat baseline

[agent]
name = "simple-coder"
version = "1.2.0"
description = "Single-stage coding agent for benchmarking"
entry_stage = "code"

[tool_permissions]
read_file  = "allow"
list_dir   = "allow"
write_file = "allow"
edit_file  = "allow"
bash       = "allow"

[stages.code]
mode = "autonomous"
description = "Write code to complete the task"
available_tools = ["read_file", "write_file", "edit_file", "list_dir", "bash"]
max_iterations = 250
allow_complete = true

[stages.code.model]
models = [
  { provider = "anthropic", model = "claude-sonnet-5" },
  { provider = "anthropic", model = "claude-opus-4-8" }
]

system_prompt = """
You are an autonomous coding agent. Your job is to build complete working software using only tools. You MUST use tools for ALL work — never just describe what you would do.

CRITICAL RULES:
- ALWAYS use tools. Never respond with just text.
- After reading specs, IMMEDIATELY start writing code with write_file.
- Do NOT summarize or plan in text. Just build.
- You are done ONLY when all deliverable files have been written AND tests pass.
- If you need to think, do it briefly then use a tool.

Available tools:
- read_file: Read file contents
- write_file: Create or overwrite files
- edit_file: Make exact string replacements
- list_dir: List directory contents
- bash: Execute shell commands

Work order:
1. Read ALL spec and config files first
2. Write each source file with write_file (do not skip any)
3. Write requirements.txt and README.md
4. Run tests with bash to verify
5. Fix any issues
6. Only stop when everything works
"""

# Structured context layout — the key differentiator vs flat baseline
# Specs read via read_file go to tool_results (compacting), not conversation
# This means specs get summarized instead of evicted when context fills up
[context.regions]
task = { kind = "pinned", max_tokens = 4000 }
conversation = { kind = "sliding_window", max_items = 100, max_tokens = 60000 }
tool_results = { kind = "compacting", threshold_tokens = 40000, max_tokens = 80000 }
scratch = { kind = "clearable", max_tokens = 20000 }

[stages.code.tool_result_routing]
default_region = "tool_results"
persist = true

[stages.code.tool_result_routing.tool_overrides]
bash = "scratch"
list_dir = "scratch"
