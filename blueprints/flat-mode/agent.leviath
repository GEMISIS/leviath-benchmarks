# flat-mode: the ABLATION arm for the structured-vs-flat context benchmark.
#
# This is the same Leviath runtime as the structured arm — same binary, same
# provider client, same prompt-caching machinery, same billed-usage accounting,
# same tools — with the region system reduced to what a conventional flat agent
# has: a pinned task (the equivalent of a system prompt, which real flat agents
# never evict) and ONE sliding conversation window holding everything else.
#
# Parity rules (any change here requires a new freeze tag; see METHODOLOGY.md):
#   - No context_* tools: the agent cannot route, pin, or compact anything.
#   - Single stage, no workflow graph, no stuck/error edges beyond the default.
#   - ONE pinned model, no fallback chain — a mid-run fallback would break
#     cross-arm comparability. Must match the structured arm's pinned model.
#   - The conversation window is sized generously for the pinned model rather
#     than artificially small; flat mode inherits Leviath's cache_control
#     breakpoints, so its caching is as good as the runtime can make it.
#     If structured still bills fewer tokens, the number is conservative.
#   - max_iterations matches the structured arm's total budget across stages.

[agent]
name = "flat-mode"
version = "1.0.0"
description = "Single flat-context arm for the structured-vs-flat ablation"
entry_stage = "code"

[tool_permissions]
read_file  = "allow"
read_files = "allow"
list_dir   = "allow"
write_file = "allow"
edit_file  = "allow"
shell      = "allow"

[stages.code]
mode = "autonomous"
description = "Complete the task in one flat context window"
available_tools = ["read_file", "read_files", "write_file", "edit_file", "list_dir", "shell"]
max_iterations = 300
allow_complete = true
system_prompt = """
You are a coding agent. Complete the task described below using the available tools.

Work systematically:
1. Read and understand the requirements and every provided spec file
2. Implement the solution
3. Test your implementation
4. Provide a summary when complete
"""

[stages.code.model]
# Pin exactly one model; keep in sync with the structured arm at freeze time.
models = [
  { provider = "anthropic", model = "claude-sonnet-5" }
]

[context.regions]
# `task` plays the role of the system prompt/task header a real flat agent
# keeps at the top of its transcript. Everything else lives in one sliding
# window — no compaction, no routing, no protected regions.
task         = { kind = "pinned", max_tokens = 4000 }
conversation = { kind = "sliding_window", max_items = 200, max_tokens = 160000 }
