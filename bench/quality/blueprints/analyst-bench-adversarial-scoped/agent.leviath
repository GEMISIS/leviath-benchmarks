# Stage-scoped variant of analyst-bench-adversarial: identical stages, prompts
# and models; each stage declares only the regions it uses.
# GENERATED by make_scoped.py - regenerate rather than editing.

[agent]
name = "data-analyst"
version = "0.7.0-adversarial-scoped"
description = "Answers analytical questions about local data files - profiles the data, computes with scripts, and verifies each figure a second way before reporting it"
entry_stage = "profile"

[tool_permissions]
read_file = "allow"
list_dir  = "allow"
bash      = "ask"

# ─── Stage 1: Profile ─────────────────────────────────────────────────────────
# Orient in the data before computing anything. Cheap model, hard cap: this
# stage answers "what is here", not "what is the answer".
[stages.profile]
mode = "autonomous"
model = { models = [{ provider = "anthropic", model = "claude-sonnet-5" }] }
description = "Inventory the data files, their formats, and their columns"
available_tools = ["read_file", "list_dir", "bash", "context_write", "context_append"]
max_iterations = 15
system_prompt = """
Find out what data you actually have before computing anything.

List the working directory, then for each data file establish: format, size, row
count, and column names with their types and units. Read the documentation
files (readme, data dictionary, manual, schema) rather than noting that they
exist: they define the fields and the domain rules that decide what a correct
answer is, and a metric defined there is the metric to compute.

Sample with the shell rather than reading whole files into context (`head`,
`wc -l`, `column -t`, a small pandas/duckdb probe). Every later stage computes
over the files on disk, so pulling their contents into context buys nothing.

Write `data_map` (context_write): one line per file as
`<file> | <format> | <rows> | <columns and what they mean>`, followed by any
domain rules the documentation states. If a field's meaning is ambiguous, say so
in that line - an ambiguous field is where wrong answers come from.

Evidence conduct, applying to everything you produce:
- Cite the source of every factual claim (file and line, log entry,
  or document section) so a reader can check it without you.
- Keep a running record of key findings together with their sources as
  you work, and reuse that record instead of trusting memory.
- If the available material does not establish something you need, ask
  for it when you have a way to ask; otherwise state the gap explicitly.
  Never fill a gap with what similar systems usually do - an unsupported
  guess presented as fact is worse than a missing value.
"""

[stages.profile.tool_routing]
# No single tool result may fill the region it lands in.
max_result_tokens = 8000
default_region = "conversation"
[stages.profile.tool_routing.overrides]
read_file = "data_preview"
list_dir  = "data_preview"
bash      = "data_preview"

# Stage-scoped layout: this stage sees what its job needs and
# nothing else. The rest are parked, not dropped - a later stage
# that declares them gets them back with their content. Every
# region this stage routes tool output into is declared here;
# routing into a parked region is a dead drop (make_scoped.py
# refuses to generate one).
# Budgets sum to 92% of this stage's window.
[stages.profile.context.regions]
task = { kind = "pinned", volatility = "stable", budget = "3%", min_tokens = 4000, required = true, seed = "task", required_message = "Say which data files to analyze and what to work out via --task." }
data_map = { kind = "pinned", volatility = "grows", budget = "6%", required = true, summarizable = false, required_message = "Write `data_map` (context_write) before leaving: one line per file with its columns, types and the domain rules its documentation states. Later stages work from this, not from raw samples." }
data_preview = { kind = "temporary", budget = "55%" }
conversation = { kind = "sliding_window", volatility = "grows", max_items = 30, budget = "25%", strategy = "bulk", overflow = 10 }
error_report = { kind = "pinned", volatility = "grows", budget = "3%" }

[stages.profile.transitions.plan]
hint = "The data is mapped - plan the computation"
transform = "direct"

# Reachable only when every normal route is spent - a
# conditioned edge is never offered to the model, so this is an
# escape and not a shortcut. Without it the run would end with
# its work discarded rather than reported.
[stages.profile.transitions.answer]
condition = "dead_end"
hint = "No route left - report what has been established"
transform = "custom"

# `custom`, not `compact`: a bare compact edge summarizes EVERY
# stage-specific region, `results` included. Figures must cross
# an edge unchanged - only the conversation is safe to summarize.
[stages.profile.transitions.answer.transform_config]
carry = ["task", "data_map", "plan", "results", "data_preview", "scripts", "scripts_history", "error_report"]
compact = ["conversation"]
clear = ["scratch"]
compact_prompt = "Summarize only what bears on the final answer: the figure, its units, and the rule it was computed under."

[stages.profile.transitions.error_recovery]
condition = "error"
transform = "direct"

# ─── Stage 2: Plan ────────────────────────────────────────────────────────────
# The expensive model spends its tokens on deciding WHAT to compute, which is
# where analytical questions are won or lost - not on writing the shell.
[stages.plan]
mode = "autonomous"
model = { models = [{ provider = "anthropic", model = "claude-opus-5" }] }
description = "Decide exactly what to compute, and what would make it wrong"
available_tools = ["read_file", "list_dir", "bash", "context_write", "context_append"]
max_iterations = 12
max_revisits = 2
system_prompt = """
Turn the question in `task` into a computation, using `data_map`.

Where the data ships documentation - a manual, a data dictionary, a readme -
its definitions govern. If it defines a metric, compute that definition, even
when an everyday reading of the question suggests a different one: "top by
fraud" means whatever the manual says fraud is, not whatever seems natural.
When two readings are genuinely defensible, name both in the plan, follow the
documented one, and say why.

Where the documentation describes how its rules or categories are applied,
settle the mechanics here rather than in the middle of computing: which fields
are optional or stand for "any value", what to do when more than one rule
applies to the same row, and what to do when none does. Write the resolution
into the plan as the rule you will follow. A procedure improvised while
computing is decided again on every run, and two runs of the same question then
disagree - which is a wrong answer that looks like a judgement call.

Write `plan` (context_write):
- the exact quantity asked for, restated unambiguously (which rows, which
  column, which filter, which time range, which unit)
- the steps to compute it, in order
- the traps: rows that must be excluded, joins that could duplicate rows, nulls,
  mixed units or currencies, dates that need parsing, categories that must match
  the documentation's definition rather than an intuitive one
- an independent way to check the result - a different route to the same number
- the exact form the final answer must take, from `task`

If the question depends on a definition you could not pin down in the data or
its documentation, state the reading you are taking and why. Do not compute
here; that is the next stage's job.

Separate the two ways a question can be hard. One is that the answer takes work
to compute. The other is that the question names something the data and its
documentation do not define - a threshold nobody wrote down, a category that
does not exist here, a comparison the data cannot support. For the second kind,
inventing a reasonable-sounding threshold and computing against it produces a
confident number that answers a question nobody asked. Say in the plan which
kind you are looking at, and if it is the second, say precisely which term is
undefined and what the data would have to contain for the question to have an
answer.

Evidence conduct, applying to everything you produce:
- Cite the source of every factual claim (file and line, log entry,
  or document section) so a reader can check it without you.
- Keep a running record of key findings together with their sources as
  you work, and reuse that record instead of trusting memory.
- If the available material does not establish something you need, ask
  for it when you have a way to ask; otherwise state the gap explicitly.
  Never fill a gap with what similar systems usually do - an unsupported
  guess presented as fact is worse than a missing value.
"""

[stages.plan.tool_routing]
# No single tool result may fill the region it lands in.
max_result_tokens = 3000
default_region = "conversation"
[stages.plan.tool_routing.overrides]
read_file = "data_preview"
bash      = "scratch"

# Stage-scoped layout: this stage sees what its job needs and
# nothing else. The rest are parked, not dropped - a later stage
# that declares them gets them back with their content. Every
# region this stage routes tool output into is declared here;
# routing into a parked region is a dead drop (make_scoped.py
# refuses to generate one).
# Budgets sum to 95% of this stage's window.
[stages.plan.context.regions]
task = { kind = "pinned", volatility = "stable", budget = "5%", min_tokens = 4000, required = true, seed = "task", required_message = "Say which data files to analyze and what to work out via --task." }
data_map = { kind = "pinned", volatility = "grows", budget = "12%", required = true, summarizable = false, required_message = "Write `data_map` (context_write) before leaving: one line per file with its columns, types and the domain rules its documentation states. Later stages work from this, not from raw samples." }
plan = { kind = "pinned", volatility = "grows", budget = "12%", required = true, summarizable = false, required_message = "Write `plan` (context_write) before computing: the exact quantity, the steps, the traps, the rule you will follow where the documentation leaves a choice, and how the result will be checked." }
data_preview = { kind = "temporary", budget = "38%" }
conversation = { kind = "sliding_window", volatility = "grows", max_items = 30, budget = "22%", strategy = "bulk", overflow = 10 }
scratch = { kind = "clearable", budget = "3%" }
error_report = { kind = "pinned", volatility = "grows", budget = "3%" }

[stages.plan.transitions.plan_review]
hint = "The plan is written - have it reviewed"
transform = "custom"
# Belt and braces on top of `required` on the region itself. Measured on
# ten runs of the composed agent, `plan` was still empty at the end of four
# of them and the run proceeded anyway - a planning stage that skips writing
# the plan takes the whole structure with it, because every later stage is
# told to work from the plan rather than from the transcript.
gate = { require_modifications = true, region = "plan", tools = ["context_write"], max_attempts = 2, message = "The plan region is still empty. Write it with context_write before moving on - the computing stage works from `plan`, not from this conversation, and the conversation is summarized on the way out." }

# `custom`, not `compact`: a bare compact edge summarizes EVERY
# stage-specific region, `results` included. Figures must cross
# an edge unchanged - only the conversation is safe to summarize.
[stages.plan.transitions.plan_review.transform_config]
carry = ["task", "data_map", "plan", "results", "data_preview", "scripts", "scripts_history", "error_report"]
compact = ["conversation"]
clear = ["scratch"]
compact_prompt = "Summarize what has been computed so far: which figures are settled, which are disputed, and what the next calculation must establish."

# Reachable only when every normal route is spent - a
# conditioned edge is never offered to the model, so this is an
# escape and not a shortcut. Without it the run would end with
# its work discarded rather than reported.
[stages.plan.transitions.answer]
condition = "dead_end"
hint = "No route left - report what has been established"
transform = "custom"

# `custom`, not `compact`: a bare compact edge summarizes EVERY
# stage-specific region, `results` included. Figures must cross
# an edge unchanged - only the conversation is safe to summarize.
[stages.plan.transitions.answer.transform_config]
carry = ["task", "data_map", "plan", "results", "data_preview", "scripts", "scripts_history", "error_report"]
compact = ["conversation"]
clear = ["scratch"]
compact_prompt = "Summarize only what bears on the final answer: the figure, its units, and the rule it was computed under."

[stages.plan.transitions.error_recovery]
condition = "error"
transform = "direct"

# ─── Stage 2b: Plan review (adversarial) ──────────────────────────────────────
# A second opinion from a different provider's model, on the plan only.
# Its job is to find the reading that makes the plan wrong - not to
# rewrite it, and not to be agreeable.
[stages.plan_review]
mode = "autonomous"
model = { models = [{ provider = "openai", model = "gpt-5.6-terra" }] }
description = "Attack the plan before any of it is computed"
# The same set as every working stage: the tool array is hashed ahead of the
# system blocks, so a narrower set here would invalidate the cache prefix on
# entry and again on exit. The narrowness of this stage is its context scope,
# not its tool list.
available_tools = ["read_file", "list_dir", "bash", "context_write", "context_append"]
max_iterations = 8
max_revisits = 2
transition_prompt = """
Decide what happens next:
- If the plan would produce a wrong or unanswerable result as written, respond with: plan
- If the plan is sound, respond with: compute
"""
system_prompt = """
You are reviewing someone else's plan before it is executed. Assume it is
wrong somewhere and go looking, using `data_map`, `plan`, and the files
themselves.

The failures worth your attention, in order:
1. A definition the data's own documentation supplies, which the plan replaced
   with an everyday reading of the question. If the manual defines the metric,
   the manual wins - a plan that notices this and argues past it is the single
   most expensive mistake available here.
2. The wrong rows: a filter that drops what should be counted, or keeps what
   should not, or a join that duplicates them.
3. A quantity that answers a nearby question rather than the one asked.
4. Units, rounding, and the required answer format.

Check the documentation yourself rather than trusting the plan's summary of it.

Append your verdict to `results` (context_append) as
`plan review = accepted | rejected: <the specific defect>`. Be concrete: name
the step and what it should be instead. If the plan is sound, say so plainly
and let it through - rejecting a good plan costs a full recomputation.

Count your own rejections in `results` before rejecting again. If you have
already sent this plan back twice, accept it with your remaining concerns
recorded and let the work proceed: a third rejection spends the revisit budget
and the run ends with no answer at all, which is worse than a flawed one you
have documented. Say "accepted under protest" and name what you still doubt.

Evidence conduct, applying to everything you produce:
- Cite the source of every factual claim (file and line, log entry,
  or document section) so a reader can check it without you.
- Keep a running record of key findings together with their sources as
  you work, and reuse that record instead of trusting memory.
- If the available material does not establish something you need, ask
  for it when you have a way to ask; otherwise state the gap explicitly.
  Never fill a gap with what similar systems usually do - an unsupported
  guess presented as fact is worse than a missing value.
"""

[stages.plan_review.tool_routing]
# No single tool result may fill the region it lands in.
max_result_tokens = 3000
default_region = "conversation"
[stages.plan_review.tool_routing.overrides]
read_file = "data_preview"
bash      = "scratch"

# Stage-scoped layout: this stage sees what its job needs and
# nothing else. The rest are parked, not dropped - a later stage
# that declares them gets them back with their content. Every
# region this stage routes tool output into is declared here;
# routing into a parked region is a dead drop (make_scoped.py
# refuses to generate one).
# Budgets sum to 95% of this stage's window.
[stages.plan_review.context.regions]
task = { kind = "pinned", volatility = "stable", budget = "8%", min_tokens = 4000, required = true, seed = "task", required_message = "Say which data files to analyze and what to work out via --task." }
data_map = { kind = "pinned", volatility = "grows", budget = "15%", required = true, summarizable = false, required_message = "Write `data_map` (context_write) before leaving: one line per file with its columns, types and the domain rules its documentation states. Later stages work from this, not from raw samples." }
plan = { kind = "pinned", volatility = "grows", budget = "30%", required = true, summarizable = false, required_message = "Write `plan` (context_write) before computing: the exact quantity, the steps, the traps, the rule you will follow where the documentation leaves a choice, and how the result will be checked." }
data_preview = { kind = "temporary", budget = "18%" }
conversation = { kind = "sliding_window", volatility = "grows", max_items = 30, budget = "18%", strategy = "bulk", overflow = 10 }
scratch = { kind = "clearable", budget = "3%" }
error_report = { kind = "pinned", volatility = "grows", budget = "3%" }

[stages.plan_review.transitions.plan]
hint = "The plan has a defect that would make the result wrong"
transform = "custom"

# `custom`, not `compact`: a bare compact edge summarizes EVERY
# stage-specific region, `results` included. Figures must cross
# an edge unchanged - only the conversation is safe to summarize.
[stages.plan_review.transitions.plan.transform_config]
carry = []
compact = ["conversation"]
clear = []
compact_prompt = "Summarize the exploration as what the data actually contains: files, columns, types, and any documented rule whose wording matters. Quote a rule rather than paraphrasing it."

# Reachable only when every normal route is spent - a
# conditioned edge is never offered to the model, so this is an
# escape and not a shortcut. Without it the run would end with
# its work discarded rather than reported.
[stages.plan_review.transitions.answer]
condition = "dead_end"
hint = "No route left - report what has been established"
transform = "custom"

# `custom`, not `compact`: a bare compact edge summarizes EVERY
# stage-specific region, `results` included. Figures must cross
# an edge unchanged - only the conversation is safe to summarize.
[stages.plan_review.transitions.answer.transform_config]
carry = []
compact = ["conversation"]
clear = []
compact_prompt = "Summarize only what bears on the final answer: the figure, its units, and the rule it was computed under."

[stages.plan_review.transitions.compute]
hint = "The plan is sound - compute it"
transform = "custom"

# `custom`, not `compact`: a bare compact edge summarizes EVERY
# stage-specific region, `results` included. Figures must cross
# an edge unchanged - only the conversation is safe to summarize.
[stages.plan_review.transitions.compute.transform_config]
carry = []
compact = ["conversation"]
clear = []
compact_prompt = "Summarize what has been computed so far: which figures are settled, which are disputed, and what the next calculation must establish."

[stages.plan_review.transitions.error_recovery]
condition = "error"
transform = "direct"


# ─── Stage 3: Compute ─────────────────────────────────────────────────────────
[stages.compute]
mode = "autonomous"
model = { models = [{ provider = "anthropic", model = "claude-sonnet-5" }] }
description = "Execute the plan with scripts and record the figures"
available_tools = ["read_file", "list_dir", "bash", "context_write", "context_append"]
max_iterations = 40
max_revisits = 5
transition_prompt = """
Decide what happens next:
- If the plan still has steps left to run, or a step failed, respond with: compute
- If you have the figure the task asked for, respond with: verify
"""
system_prompt = """
Execute `plan` with scripts - awk/grep/sort for simple aggregates, python or
duckdb for anything with joins, dates, or grouping.

Work in small steps and check each one's output before building on it: print the
row count after every filter, and look at whether it moved the way you expected.
A filter that silently matched nothing produces a confident, wrong zero.

Append every figure you establish to `results` (context_append) as
`<what it measures> = <value> | <how it was computed>`. Script code and output
land in `scripts`.

`results` is the only region the stage that writes the final answer can read.
It cannot open files, rerun a script, or look at `scripts`. So whatever the
question actually asks for has to be *in* `results`, in full: if the answer is
a list of four hundred ids, the four hundred ids go in `results`, not a note
saying they are in a file. A pointer to a file you can see is, to the stage
that answers, a pointer to nothing.

Follow the plan's units and rounding. If the data contradicts the plan - a column
is not what `data_map` said, a join explodes the row count - say so in `results`
rather than quietly working around it.

Evidence conduct, applying to everything you produce:
- Cite the source of every factual claim (file and line, log entry,
  or document section) so a reader can check it without you.
- Keep a running record of key findings together with their sources as
  you work, and reuse that record instead of trusting memory.
- If the available material does not establish something you need, ask
  for it when you have a way to ask; otherwise state the gap explicitly.
  Never fill a gap with what similar systems usually do - an unsupported
  guess presented as fact is worse than a missing value.
"""

[stages.compute.tool_routing]
# No single tool result may fill the region it lands in.
max_result_tokens = 4000
default_region = "scripts"
[stages.compute.tool_routing.overrides]
read_file = "data_preview"

# Stage-scoped layout: this stage sees what its job needs and
# nothing else. The rest are parked, not dropped - a later stage
# that declares them gets them back with their content. Every
# region this stage routes tool output into is declared here;
# routing into a parked region is a dead drop (make_scoped.py
# refuses to generate one).
# Budgets sum to 95% of this stage's window.
[stages.compute.context.regions]
task = { kind = "pinned", volatility = "stable", budget = "3%", min_tokens = 4000, required = true, seed = "task", required_message = "Say which data files to analyze and what to work out via --task." }
data_map = { kind = "pinned", volatility = "grows", budget = "6%", required = true, summarizable = false, required_message = "Write `data_map` (context_write) before leaving: one line per file with its columns, types and the domain rules its documentation states. Later stages work from this, not from raw samples." }
plan = { kind = "pinned", volatility = "grows", budget = "10%", required = true, summarizable = false, required_message = "Write `plan` (context_write) before computing: the exact quantity, the steps, the traps, the rule you will follow where the documentation leaves a choice, and how the result will be checked." }
results = { kind = "sliding_window", volatility = "grows", max_items = 30, budget = "14%", strategy = "bulk", overflow = 10, summarizable = false }
scripts = { kind = "compacting", budget = "22%", compact_at = "80%" }
scripts_history = { kind = "compact_history", volatility = "grows", source_region = "scripts", budget = "3%" }
data_preview = { kind = "temporary", budget = "18%" }
conversation = { kind = "sliding_window", volatility = "grows", max_items = 30, budget = "16%", strategy = "bulk", overflow = 10 }
error_report = { kind = "pinned", volatility = "grows", budget = "3%" }

[stages.compute.transitions.compute]
hint = "More of the plan left to run"
transform = "direct"

# Reachable only when every normal route is spent - a
# conditioned edge is never offered to the model, so this is an
# escape and not a shortcut. Without it the run would end with
# its work discarded rather than reported.
[stages.compute.transitions.answer]
condition = "dead_end"
hint = "No route left - report what has been established"
transform = "custom"

# `custom`, not `compact`: a bare compact edge summarizes EVERY
# stage-specific region, `results` included. Figures must cross
# an edge unchanged - only the conversation is safe to summarize.
[stages.compute.transitions.answer.transform_config]
carry = ["task", "data_map", "plan", "results", "data_preview", "scripts", "scripts_history", "error_report"]
compact = ["conversation"]
clear = ["scratch"]
compact_prompt = "Summarize only what bears on the final answer: the figure, its units, and the rule it was computed under."

[stages.compute.transitions.verify]
hint = "The figure is computed - check it"
transform = "custom"

# `custom`, not `compact`: a bare compact edge summarizes EVERY
# stage-specific region, `results` included. Figures must cross
# an edge unchanged - only the conversation is safe to summarize.
[stages.compute.transitions.verify.transform_config]
carry = ["task", "data_map", "plan", "results", "data_preview", "scripts", "scripts_history", "error_report"]
compact = ["conversation"]
clear = ["scratch"]
compact_prompt = "Summarize how each figure was produced: the filter applied, the rows it selected, and the arithmetic. Enough for someone to reproduce it without rereading the transcript."

[stages.compute.transitions.error_recovery]
condition = "error"
transform = "direct"

# ─── Stage 4: Verify ──────────────────────────────────────────────────────────
# A second, independent route to the same number. Analytical answers fail
# quietly - the script runs, the number is wrong - so the check is a stage,
# not a suggestion.
[stages.verify]
mode = "autonomous"
model = { models = [{ provider = "anthropic", model = "claude-opus-5" }] }
description = "Recompute the answer a second way and reconcile"
available_tools = ["read_file", "list_dir", "bash", "context_write", "context_append"]
max_iterations = 12
max_revisits = 2
transition_prompt = """
Decide what happens next:
- If the check disagrees with the computed figure, or exposed a mistake in the
  approach, respond with: compute
- If the figure holds up, respond with: answer
"""
system_prompt = """
Check the question before you check the arithmetic. Re-read `task` as if you had
not seen the plan, and ask whether the quantity in `results` is what it asks
for. Where the plan committed to a rule the documentation describes, check that
rule against the documentation itself rather than against the plan's account of
it: a plan that read the rules wrongly will describe its own reading
convincingly, and recomputing under it agrees every time. Where the data's documentation defines the metric, that definition decides
it - a figure computed correctly under the wrong definition is a wrong answer,
and recomputing it a second way will confirm it every time. If the reading is
wrong, say so and send it back; that is the failure this stage exists to catch.

Then recompute the answer by the independent route named in `plan` - a different
grouping, a different tool, a manual count on a small slice, an identity that
must hold (parts summing to the total).

Sanity-check the result: is the magnitude plausible for this many rows, is the
unit right, is the answer in the form the task demands?

Then hand off the deliverable. Write `answer_draft` (context_write) containing
the answer itself, complete, in the form `task` asks for - not a description of
it, not its length, not a pointer to a file that holds it. Where the answer is
long, write it out in full anyway. The stage that responds has no tools and
cannot see the data, the scripts or your scratch space: whatever is not in
`answer_draft` does not exist as far as the answer is concerned, and a model
asked to produce an answer it cannot see will produce one anyway.

Append the check and its outcome to `results`. If the two routes disagree,
say which one you believe and why, and go back to compute rather than averaging
them or picking the friendlier number.

Evidence conduct, applying to everything you produce:
- Cite the source of every factual claim (file and line, log entry,
  or document section) so a reader can check it without you.
- Keep a running record of key findings together with their sources as
  you work, and reuse that record instead of trusting memory.
- If the available material does not establish something you need, ask
  for it when you have a way to ask; otherwise state the gap explicitly.
  Never fill a gap with what similar systems usually do - an unsupported
  guess presented as fact is worse than a missing value.
"""

[stages.verify.tool_routing]
# No single tool result may fill the region it lands in.
max_result_tokens = 4000
default_region = "scripts"
[stages.verify.tool_routing.overrides]
read_file = "data_preview"

# Stage-scoped layout: this stage sees what its job needs and
# nothing else. The rest are parked, not dropped - a later stage
# that declares them gets them back with their content. Every
# region this stage routes tool output into is declared here;
# routing into a parked region is a dead drop (make_scoped.py
# refuses to generate one).
# Budgets sum to 97% of this stage's window.
[stages.verify.context.regions]
task = { kind = "pinned", volatility = "stable", budget = "5%", min_tokens = 4000, required = true, seed = "task", required_message = "Say which data files to analyze and what to work out via --task." }
plan = { kind = "pinned", volatility = "grows", budget = "12%", required = true, summarizable = false, required_message = "Write `plan` (context_write) before computing: the exact quantity, the steps, the traps, the rule you will follow where the documentation leaves a choice, and how the result will be checked." }
results = { kind = "sliding_window", volatility = "grows", max_items = 30, budget = "18%", strategy = "bulk", overflow = 10, summarizable = false }
scripts = { kind = "compacting", budget = "14%", compact_at = "80%" }
scripts_history = { kind = "compact_history", volatility = "grows", source_region = "scripts", budget = "3%" }
data_preview = { kind = "temporary", budget = "15%" }
answer_draft = { kind = "pinned", volatility = "grows", budget = "12%", required = true, summarizable = false, required_message = "Write `answer_draft` (context_write): the deliverable itself, complete and in the form `task` asks for. Not a summary of it, not its length, not where it is stored - the content." }
conversation = { kind = "sliding_window", volatility = "grows", max_items = 30, budget = "15%", strategy = "bulk", overflow = 10 }
error_report = { kind = "pinned", volatility = "grows", budget = "3%" }

[stages.verify.transitions.compute]
hint = "The check disagrees - recompute"
transform = "custom"

# `custom`, not `compact`: a bare compact edge summarizes EVERY
# stage-specific region, `results` included. Figures must cross
# an edge unchanged - only the conversation is safe to summarize.
[stages.verify.transitions.compute.transform_config]
carry = ["task", "data_map", "plan", "results", "data_preview", "scripts", "scripts_history", "error_report"]
compact = ["conversation"]
clear = ["scratch"]
compact_prompt = "Summarize what has been computed so far: which figures are settled, which are disputed, and what the next calculation must establish."

[stages.verify.transitions.answer]
hint = "The figure holds up - answer"
transform = "custom"

# `custom`, not `compact`: a bare compact edge summarizes EVERY
# stage-specific region, `results` included. Figures must cross
# an edge unchanged - only the conversation is safe to summarize.
[stages.verify.transitions.answer.transform_config]
carry = ["task", "data_map", "plan", "results", "data_preview", "scripts", "scripts_history", "error_report"]
compact = ["conversation"]
clear = ["scratch"]
compact_prompt = "Summarize only what bears on the final answer: the figure, its units, and the rule it was computed under."

[stages.verify.transitions.error_recovery]
condition = "error"
transform = "direct"

# ─── Stage 5: Error recovery ──────────────────────────────────────────────────
[stages.error_recovery]
mode = "autonomous"
model = { models = [{ provider = "anthropic", model = "claude-sonnet-5" }] }
description = "Recover from a failed read or script execution"
available_tools = ["read_file", "list_dir", "bash", "context_write", "context_append"]
max_iterations = 10
max_revisits = 1
system_prompt = """
A read or a script failed. The `error_report` region holds the error text the
runtime captured - read it first, diagnose it (a bad path, a parse error, a
missing package, a memory blow-up on a large file), note the workaround, and
return to compute with an approach that avoids it.

A tool that will not run is not a reason to stop: chunk the file, use a
different library, or compute the same quantity another way.

Evidence conduct, applying to everything you produce:
- Cite the source of every factual claim (file and line, log entry,
  or document section) so a reader can check it without you.
- Keep a running record of key findings together with their sources as
  you work, and reuse that record instead of trusting memory.
- If the available material does not establish something you need, ask
  for it when you have a way to ask; otherwise state the gap explicitly.
  Never fill a gap with what similar systems usually do - an unsupported
  guess presented as fact is worse than a missing value.
"""

# Un-exhaustible escape (lint: dead-end-possible).
# Recovery reads diagnostics, which can be large; they go to
# an evictable region rather than the conversation.
[stages.error_recovery.tool_routing]
default_region = "scratch"
max_result_tokens = 4000
[stages.error_recovery.tool_routing.overrides]
read_file = "data_preview"

# Stage-scoped layout: this stage sees what its job needs and
# nothing else. The rest are parked, not dropped - a later stage
# that declares them gets them back with their content. Every
# region this stage routes tool output into is declared here;
# routing into a parked region is a dead drop (make_scoped.py
# refuses to generate one).
# Budgets sum to 95% of this stage's window.
[stages.error_recovery.context.regions]
task = { kind = "pinned", volatility = "stable", budget = "5%", min_tokens = 4000, required = true, seed = "task", required_message = "Say which data files to analyze and what to work out via --task." }
plan = { kind = "pinned", volatility = "grows", budget = "10%", required = true, summarizable = false, required_message = "Write `plan` (context_write) before computing: the exact quantity, the steps, the traps, the rule you will follow where the documentation leaves a choice, and how the result will be checked." }
results = { kind = "sliding_window", volatility = "grows", max_items = 30, budget = "15%", strategy = "bulk", overflow = 10, summarizable = false }
scripts = { kind = "compacting", budget = "20%", compact_at = "80%" }
data_preview = { kind = "temporary", budget = "15%" }
conversation = { kind = "sliding_window", volatility = "grows", max_items = 30, budget = "22%", strategy = "bulk", overflow = 10 }
scratch = { kind = "clearable", budget = "3%" }
error_report = { kind = "pinned", volatility = "grows", budget = "5%" }

[stages.error_recovery.transitions.answer]
hint = "Recovery is not converging - answer with what has been established"
transform = "custom"

# `custom`, not `compact`: a bare compact edge summarizes EVERY
# stage-specific region, `results` included. Figures must cross
# an edge unchanged - only the conversation is safe to summarize.
[stages.error_recovery.transitions.answer.transform_config]
carry = ["task", "data_map", "plan", "results", "data_preview", "scripts", "scripts_history", "error_report"]
compact = ["conversation"]
clear = ["scratch"]
compact_prompt = "Summarize only what bears on the final answer: the figure, its units, and the rule it was computed under."

[stages.error_recovery.transitions.compute]
hint = "Recovered - resume computing"
transform = "custom"

# `custom`, not `compact`: a bare compact edge summarizes EVERY
# stage-specific region, `results` included. Figures must cross
# an edge unchanged - only the conversation is safe to summarize.
[stages.error_recovery.transitions.compute.transform_config]
carry = ["task", "data_map", "plan", "results", "data_preview", "scripts", "scripts_history", "error_report"]
compact = ["conversation"]
clear = ["scratch"]
compact_prompt = "Summarize what has been computed so far: which figures are settled, which are disputed, and what the next calculation must establish."

[compaction]
provider = "anthropic"
model = "claude-sonnet-5"

# ─── Final output ─────────────────────────────────────────────────────────────
# Terminal. `mode = "output"` grants `submit_output`, requires the call, and
# lets the run end here. No file or shell tools on purpose: this stage reports
# what `results` established, it does not compute.
[stages.answer]
mode = "output"
model = { models = [{ provider = "anthropic", model = "claude-sonnet-5" }] }
description = "Answer the question that was asked"
# Reporting an answer is one call. The budget covers a retry -
# a schema refusal handed back, a format corrected - not a loop:
# an unbounded output stage bills its whole context per attempt.
max_iterations = 5
system_prompt = """
Answer the question in `task`, in exactly the form it asked for.

If the task states an exact output format - a required final line, a particular
shape, "reply with only X" - reproduce it literally, with nothing wrapped around
it. An answer that is right but not in the requested form is unusable by whoever
asked, so it is not an answer.

If it asked for a value, give the value and nothing else - no preamble, no
restating the question, no units it did not ask for. If it asked for an
explanation, lead with the answer, then the figures from `results` that support
it, then anything that stayed uncertain.

`answer_draft` holds the deliverable as the checking stage committed it. Emit
that content - reformatted to the task's requested shape if it is not already,
but not regenerated. You cannot see the data, the scripts, or the working: the
deliverable is either in front of you or it is nowhere you can reach.

So: never reconstruct, extend, or fill in content that is not in front of you.
If `answer_draft` and `results` do not contain what the task asks for, say
exactly that - name what is missing. A wrong answer that looks complete is
worse than a short one that admits the gap, because nobody downstream can tell
the first one is wrong.

Evidence conduct, applying to everything you produce:
- Cite the source of every factual claim (file and line, log entry,
  or document section) so a reader can check it without you.
- Keep a running record of key findings together with their sources as
  you work, and reuse that record instead of trusting memory.
- If the available material does not establish something you need, ask
  for it when you have a way to ask; otherwise state the gap explicitly.
  Never fill a gap with what similar systems usually do - an unsupported
  guess presented as fact is worse than a missing value.
"""

# Stage-scoped layout: this stage sees what its job needs and
# nothing else. The rest are parked, not dropped - a later stage
# that declares them gets them back with their content. Every
# region this stage routes tool output into is declared here;
# routing into a parked region is a dead drop (make_scoped.py
# refuses to generate one).
# Budgets sum to 91% of this stage's window.
[stages.answer.context.regions]
task = { kind = "pinned", volatility = "stable", budget = "8%", min_tokens = 4000, required = true, seed = "task", required_message = "Say which data files to analyze and what to work out via --task." }
plan = { kind = "pinned", volatility = "grows", budget = "8%", required = true, summarizable = false, required_message = "Write `plan` (context_write) before computing: the exact quantity, the steps, the traps, the rule you will follow where the documentation leaves a choice, and how the result will be checked." }
results = { kind = "sliding_window", volatility = "grows", max_items = 30, budget = "22%", strategy = "bulk", overflow = 10, summarizable = false }
answer_draft = { kind = "pinned", volatility = "grows", budget = "30%", required = false, summarizable = false, required_message = "Write `answer_draft` (context_write): the deliverable itself, complete and in the form `task` asks for. Not a summary of it, not its length, not where it is stored - the content." }
conversation = { kind = "sliding_window", volatility = "grows", max_items = 30, budget = "20%", strategy = "bulk", overflow = 10 }
error_report = { kind = "pinned", volatility = "grows", budget = "3%" }

[stages.answer.transitions]

# ─── Context layout ───────────────────────────────────────────────────────────
[context.regions]
# Cache contract (verified against leviath 0.3.6): the provider-visible
# prompt is [pinned regions in declaration order][stage_instructions]
# [sliding][compacting][temporary/clearable], and the tool array is hashed
# ahead of all of it. So every working stage advertises the SAME
# available_tools, `stage_instructions` is declared so the per-stage prompt
# stops landing inside `task` (the first pinned region - which rewrote
# block 1 of the prefix on every transition), and pinned regions are
# declared stable-first so a region that fills late invalidates only what
# sits behind it.
task         = { kind = "pinned", volatility = "stable", budget = "2%", min_tokens = 4000, required = true, seed = "task", required_message = "Say which data files to analyze and what to work out via --task." }
# What the data is: written once in profile, read by every later stage.
data_map     = { kind = "pinned", volatility = "grows", budget = "3%", required = true, summarizable = false, required_message = "Write `data_map` (context_write) before leaving: one line per file with its columns, types and the domain rules its documentation states. Later stages work from this, not from raw samples." }
# The computation and its traps: the contract the compute stage executes.
plan         = { kind = "pinned", volatility = "grows", budget = "3%", required = true, summarizable = false, required_message = "Write `plan` (context_write) before computing: the exact quantity, the steps, the traps, the rule you will follow where the documentation leaves a choice, and how the result will be checked." }
# Every figure established, with how it was computed.
results      = { kind = "sliding_window", volatility = "grows", max_items = 30, budget = "8%", strategy = "bulk", overflow = 10, summarizable = false }
# The deliverable itself, committed by the stage that checked it. Separate
# from `results` because working notes and the answer are different things:
# `results` accumulates figures and how they were derived, and a stage reading
# it cannot tell which part IS the answer. Pinned, so no transform touches it;
# required, so a checking stage that forgets to write it is re-run and told to.
# The failure this exists to stop: an output stage with no tools, handed only
# a description of a four-hundred-item answer, invents four hundred items.
answer_draft = { kind = "pinned", volatility = "grows", budget = "10%", required = false, summarizable = false, required_message = "Write `answer_draft` (context_write): the deliverable itself, complete and in the form `task` asks for. Not a summary of it, not its length, not where it is stored - the content." }

# Bulk and evictable: samples of the data pulled in for orientation.
data_preview = { kind = "temporary", budget = "28%" }
# Script code and output, compacted as the loop runs.
scripts      = { kind = "compacting", budget = "22%", compact_at = "80%" }
scripts_history = { kind = "compact_history", volatility = "grows", source_region = "scripts", budget = "3%" }

conversation = { kind = "sliding_window", volatility = "grows", max_items = 30, budget = "20%", strategy = "bulk", overflow = 10 }
scratch      = { kind = "clearable", budget = "4%" }

# Written by the runtime on an abnormal stage ending: a failed inference call's
# error text, or a note that a stage hit its iteration cap. Pinned so it
# survives the edge transform into the stage that acts on it.
error_report = { kind = "pinned", volatility = "grows", budget = "2%" }

# The per-stage system prompt. Declared, the runtime keeps it at the END of
# the pinned block run; undeclared, it is injected into the first pinned
# region (`task`), which rewrites the head of the prompt every transition.
stage_instructions = { kind = "pinned", volatility = "stable", budget = "3%", max_tokens = 4000 }
