# Read-only counterpart of loganalyzer-bench-adversarial-scoped-flagship - GENERATED by make_readonly.py for the
# hallucination suite's log tasks; do not edit by hand. No shell, no writes,
# scripted-workflow prompt passages replaced, read results capped per tool.
# flagship mix of loganalyzer-bench-adversarial-scoped: identical shape, one model named per stage.
# GENERATED by make_mix.py from mixes.json - do not edit by hand.
#   ingest           openai/gpt-5.6-luna
#   analyze          anthropic/claude-opus-5
#   analysis_review  openrouter/x-ai/grok-4.6
#   report           anthropic/claude-opus-5
#   verify           anthropic/claude-sonnet-5
#   error_recovery   anthropic/claude-opus-5
#   summary          openai/gpt-5.6-luna

[agent]
name = "log-analyzer"
version = "0.4.0-adversarial-scoped"
description = "Analyzes log files by reading them - identifies anomalies, trends, and error patterns, fact-checks its own report against the sources before delivering (read-only condition)"
entry_stage = "ingest"

[tool_permissions]
read_file = "allow"
list_dir  = "allow"
bash      = "ask"
write_file = "ask"

# ─── Stage 1: Ingest ──────────────────────────────────────────────────────────
[stages.ingest]
mode = "autonomous"
model = { models = [{ provider = "openai", model = "gpt-5.6-luna" }] }
description = "Read log files, identify format and structure"
available_tools = ["read_file", "list_dir", "context_write", "context_append"]
max_iterations = 25
system_prompt = """
Ingest the log files named in `task`. Determine:
1. Log format (JSON, syslog, Apache, custom, etc.)
2. Time range covered and total volume
3. Available fields/columns
4. Obvious structural issues (corrupted lines, encoding problems)

Work from file reads alone: list the directories first, then read files
selectively - newest and oldest rotations, and whatever the reference
documents point at. Long results are truncated at a fixed size, so pull the
essentials into your notes as you read instead of planning to re-read. Write a
short format/structure summary to `findings` (context_write) so the analyze stage
starts oriented. Raw sampled content lands in `logs`.

Evidence conduct, applying to everything you produce:
- Cite the source of every factual claim (file and line, log entry,
  or document section) so a reader can check it without you.
- Keep a running record of key findings together with their sources as
  you work, and reuse that record instead of trusting memory.
- If the available material does not establish something you need, ask
  for it when you have a way to ask; otherwise state the gap explicitly.
  Never fill a gap with what similar systems usually do - an unsupported
  guess presented as fact is worse than a missing value.
"""

[stages.ingest.tool_routing]
# No single tool result may fill the region it lands in.
max_result_tokens = 6000
default_region = "conversation"
[stages.ingest.tool_routing.overrides]
read_file = { region = "logs", max_result_tokens = 16000 }

# Compacted, not direct: ingest owns the largest `logs` allocation, and a
# direct edge hands analyze an unfiltered inheritance of the whole binge.
# The distilled findings cross in `findings`; the conversation crosses as
# a summary with its figures intact.
# Stage-scoped layout: this stage sees what its job needs and
# nothing else. The rest are parked, not dropped - a later stage
# that declares them gets them back with their content. Every
# region this stage routes tool output into is declared here;
# routing into a parked region is a dead drop (make_scoped.py
# refuses to generate one).
# Budgets sum to 94% of this stage's window.
[stages.ingest.context.regions]
task = { kind = "pinned", volatility = "stable", budget = "4%", min_tokens = 4000, required = true, seed = "task", required_message = "Name the log file(s)/dir and what to look for via --task." }
findings = { kind = "sliding_window", volatility = "grows", max_items = 30, budget = "8%", strategy = "bulk", overflow = 10, summarizable = false }
logs = { kind = "temporary", volatility = "grows", budget = "55%" }
conversation = { kind = "sliding_window", volatility = "grows", max_items = 30, budget = "24%", strategy = "bulk", overflow = 10 }
error_report = { kind = "pinned", volatility = "grows", budget = "3%" }

[stages.ingest.transitions.analyze]
hint = "Log format identified, ready to analyze"
transform = "custom"

[stages.ingest.transitions.analyze.transform_config]
carry = []
compact = ["conversation"]
clear = []
compact_prompt = "Summarize the conversation so far, preserving every figure verbatim."

# Reachable only when every normal route is spent - a
# conditioned edge is never offered to the model, so this is an
# escape and not a shortcut. Without it the run would end with
# its work discarded rather than reported.
[stages.ingest.transitions.summary]
condition = "dead_end"
hint = "No route left - report what has been established"
transform = "custom"

# `custom`, not `compact`: a bare compact edge summarizes EVERY
# stage-specific region, `results` included. Figures must cross
# an edge unchanged - only the conversation is safe to summarize.
[stages.ingest.transitions.summary.transform_config]
carry = []
compact = ["conversation"]
clear = []
compact_prompt = "Summarize the conversation so far, preserving every figure verbatim."

[stages.ingest.transitions.error_recovery]
condition = "error"
transform = "direct"

# ─── Stage 2: Analyze ─────────────────────────────────────────────────────────
[stages.analyze]
mode = "autonomous"
model = { models = [{ provider = "anthropic", model = "claude-opus-5" }] }
description = "Identify anomalies, trends, and error patterns"
available_tools = ["read_file", "list_dir", "context_write", "context_append"]
max_iterations = 40
max_revisits = 3
transition_prompt = """
Decide what happens next:
- If the task asked a specific question and you can now answer it, respond with: summary
- If the task asked for a written report or a broad review of these logs, respond with: analysis_review
"""
system_prompt = """
Match the work to what was asked. If `task` asks a specific question - a count, a
timestamp, which host, when something first appeared - establish that answer
precisely and go to summary; do not tour the rest of the file or write a report
nobody asked for. Only when the task asks for a review, an investigation, or a
written report do you sweep the log for everything below.

Analyze the log data for:
1. Error patterns - recurring errors, error spikes, cascading failures
2. Anomalies - unusual request rates, latency outliers, unexpected status codes
3. Trends - gradual degradation, growing queue depths, memory creep
4. Correlations - errors that co-occur, time-based patterns
5. Security signals - auth failures, unusual access, injection attempts

Quantify everything (timestamps, counts, rates). For each finding, append to
`findings` (context_append): `<SEVERITY> | <finding> | <evidence: counts/timestamps>`
with SEVERITY in {critical, warning, info}. Keep a running tally in `severity_index`
(context_write), e.g. "critical: 2, warning: 5, info: 3". When a count matters,
count it from the file text you actually read and cite the file and time range
it came from.

If `error_report` says a previous stage hit its iteration cap, that stage was cut
off before finishing - treat its output as incomplete and re-check what it missed.

Evidence conduct, applying to everything you produce:
- Cite the source of every factual claim (file and line, log entry,
  or document section) so a reader can check it without you.
- Keep a running record of key findings together with their sources as
  you work, and reuse that record instead of trusting memory.
- If the available material does not establish something you need, ask
  for it when you have a way to ask; otherwise state the gap explicitly.
  Never fill a gap with what similar systems usually do - an unsupported
  guess presented as fact is worse than a missing value.
"""

[stages.analyze.tool_routing]
# No single tool result may fill the region it lands in.
max_result_tokens = 4000
default_region = "conversation"
[stages.analyze.tool_routing.overrides]
read_file = { region = "logs", max_result_tokens = 16000 }

# The deliverable follows the request: a written report when one was
# asked for, otherwise the answer to the question that was asked.
# Stage-scoped layout: this stage sees what its job needs and
# nothing else. The rest are parked, not dropped - a later stage
# that declares them gets them back with their content. Every
# region this stage routes tool output into is declared here;
# routing into a parked region is a dead drop (make_scoped.py
# refuses to generate one).
# Budgets sum to 91% of this stage's window.
[stages.analyze.context.regions]
task = { kind = "pinned", volatility = "stable", budget = "4%", min_tokens = 4000, required = true, seed = "task", required_message = "Name the log file(s)/dir and what to look for via --task." }
severity_index = { kind = "pinned", volatility = "grows", budget = "2%", summarizable = false }
findings = { kind = "sliding_window", volatility = "grows", max_items = 30, budget = "14%", strategy = "bulk", overflow = 10, summarizable = false, required = true }
logs = { kind = "temporary", volatility = "grows", budget = "34%" }
conversation = { kind = "sliding_window", volatility = "grows", max_items = 30, budget = "22%", strategy = "bulk", overflow = 10 }
scratch = { kind = "clearable", budget = "12%" }
error_report = { kind = "pinned", volatility = "grows", budget = "3%" }

[stages.analyze.transitions.summary]
hint = "The task asked a specific question and the analysis answers it"
transform = "custom"

# `custom`, not `compact`: a bare compact edge summarizes EVERY
# stage-specific region, `results` included. Figures must cross
# an edge unchanged - only the conversation is safe to summarize.
[stages.analyze.transitions.summary.transform_config]
carry = []
compact = ["conversation"]
clear = []
compact_prompt = "Summarize the conversation so far, preserving every figure verbatim."

[stages.analyze.transitions.analysis_review]
hint = "The analysis is drafted - have it attacked before the report is written"
transform = "custom"

# `custom`, not `compact`: a bare compact edge summarizes EVERY
# stage-specific region, `results` included. Figures must cross
# an edge unchanged - only the conversation is safe to summarize.
[stages.analyze.transitions.analysis_review.transform_config]
carry = []
compact = ["conversation"]
clear = []
compact_prompt = "Summarize the conversation so far, preserving every figure verbatim."

[stages.analyze.transitions.error_recovery]
condition = "error"
transform = "direct"

# ─── Stage 2b: Analysis review (adversarial) ──────────────────────────────────
# A second opinion from a different provider's model, on the analysis only.
# Inserted between analyze and report: analyze's forward edge to report is
# redirected through this stage. Its job is to find the reading that makes
# the analysis wrong - not to redo it, and not to be agreeable.
[stages.analysis_review]
mode = "autonomous"
model = { models = [{ provider = "openrouter", model = "x-ai/grok-4.6" }] }
description = "Attack the analysis before the report is written from it"
# The same set as every working stage: the tool array is hashed ahead of the
# system blocks, so a narrower set here would invalidate the cache prefix on
# entry and again on exit. The narrowness of this stage is its context scope,
# not its tool list.
available_tools = ["read_file", "list_dir", "context_write", "context_append"]
max_iterations = 8
max_revisits = 2
transition_prompt = """
Decide what happens next:
- If the analysis has a defect that would make the report wrong, respond with: analyze
- If the analysis is sound, respond with: report
"""
system_prompt = """
You are reviewing someone else's log analysis before the report is written
from it. Assume it is wrong somewhere and go looking, using `findings`,
`severity_index`, and the log files themselves.

The failures worth your attention, in order:
1. A hypothesis that mistakes a symptom for its cause - the loudest error
   taken as the origin when earlier, quieter lines show what actually
   started the cascade. A report built on a symptom will describe it very
   precisely and still answer the wrong question.
2. A severity call the log lines do not support: a `critical` with no
   evidence of impact in the lines cited, or an `info` that the raw lines
   show recurring at rates that make it a warning or worse.
3. A pattern claimed from too few lines - a "spike", "trend", or
   "correlation" resting on two or three occurrences, where the base rate
   was never checked.
4. A time window or component filter that would miss the incident:
   analysis confined to hours or services the log lines themselves show
   to be the wrong ones.

Check `findings` and `severity_index` against the actual log lines yourself
(read_file, bash) rather than trusting the analysis's summary of them.
Recount a claimed count; re-grep a claimed pattern outside the claimed
window.

Append your verdict to `findings` (context_append) as
`analysis review = accepted | rejected: <the specific defect>`. Be concrete:
name the finding and what the log lines say instead. If the analysis is
sound, say so plainly and let it through - rejecting a sound analysis costs
a full re-analysis pass.

Count your own rejections in `findings` before rejecting again. If you have
already sent this analysis back twice, accept it with your remaining
concerns recorded and let the work proceed: a third rejection spends the
revisit budget and the run ends with no answer at all, which is worse than
a flawed one you have documented. Say "accepted under protest" and name
what you still doubt.

Evidence conduct, applying to everything you produce:
- Cite the source of every factual claim (file and line, log entry,
  or document section) so a reader can check it without you.
- Keep a running record of key findings together with their sources as
  you work, and reuse that record instead of trusting memory.
- If the available material does not establish something you need, ask
  for it when you have a way to ask; otherwise state the gap explicitly.
  Never fill a gap with what similar systems usually do - an unsupported
  guess presented as fact is worse than a missing value.
"""

[stages.analysis_review.tool_routing]
# No single tool result may fill the region it lands in.
max_result_tokens = 3000
default_region = "conversation"
[stages.analysis_review.tool_routing.overrides]
read_file = { region = "logs", max_result_tokens = 16000 }

# Stage-scoped layout: this stage sees what its job needs and
# nothing else. The rest are parked, not dropped - a later stage
# that declares them gets them back with their content. Every
# region this stage routes tool output into is declared here;
# routing into a parked region is a dead drop (make_scoped.py
# refuses to generate one).
# Budgets sum to 95% of this stage's window.
[stages.analysis_review.context.regions]
task = { kind = "pinned", volatility = "stable", budget = "6%", min_tokens = 4000, required = true, seed = "task", required_message = "Name the log file(s)/dir and what to look for via --task." }
severity_index = { kind = "pinned", volatility = "grows", budget = "4%", summarizable = false }
findings = { kind = "sliding_window", volatility = "grows", max_items = 30, budget = "20%", strategy = "bulk", overflow = 10, summarizable = false }
logs = { kind = "temporary", volatility = "grows", budget = "35%" }
conversation = { kind = "sliding_window", volatility = "grows", max_items = 30, budget = "22%", strategy = "bulk", overflow = 10 }
scratch = { kind = "clearable", budget = "5%" }
error_report = { kind = "pinned", volatility = "grows", budget = "3%" }

[stages.analysis_review.transitions.analyze]
hint = "The analysis has a defect that would make the scripts or the answer wrong"
transform = "custom"

# `custom`, not `compact`: a bare compact edge summarizes EVERY
# stage-specific region, `findings` included. Figures must cross
# an edge unchanged - only the conversation is safe to summarize.
[stages.analysis_review.transitions.analyze.transform_config]
carry = []
compact = ["conversation"]
clear = []
compact_prompt = "Summarize the review as what the logs actually show: quote the log lines that contradict a finding rather than paraphrasing them, and preserve every count and timestamp verbatim."

# Unconditioned, so it doubles as the escape: report has no revisit
# budget, so this edge is always available even when analyze's revisits
# are spent - the run can always move forward to the deliverable.
[stages.analysis_review.transitions.report]
hint = "The analysis is sound - write the report"
transform = "custom"

# `custom`, not `compact`: a bare compact edge summarizes EVERY
# stage-specific region, `findings` included. Figures must cross
# an edge unchanged - only the conversation is safe to summarize.
[stages.analysis_review.transitions.report.transform_config]
carry = []
compact = ["conversation"]
clear = []
compact_prompt = "Summarize only what bears on the report: which findings are verified, which are disputed and why, with every count and timestamp preserved verbatim."

[stages.analysis_review.transitions.error_recovery]
condition = "error"
transform = "direct"

# ─── Stage 3: Script ──────────────────────────────────────────────────────────
# ─── Stage 3: Report ──────────────────────────────────────────────────────────
[stages.report]
mode = "autonomous"
model = { models = [{ provider = "anthropic", model = "claude-opus-5" }] }
description = "Produce a structured analysis report with findings"
available_tools = ["read_file", "list_dir", "context_write", "context_append"]
max_iterations = 10
# Generating the final report - don't inject mid-run user messages into it.
accepts_messages = false
system_prompt = """
Check `task` first. If it only asked a specific question, writing a report is
work nobody asked for: do not write one, and move to summary with the answer.

Otherwise the task asked for a written report, so write one.

Write a structured log analysis report from the `findings` region, structured
by the `severity_index` tally. Include:
- Executive summary (top findings in 3-5 bullets)
- Log source overview (files, format, time range, volume)
- Findings by severity (🔴 critical / 🟡 warning / 🔵 info)
  - For each: description, evidence (counts/timestamps), impact
- Trends and patterns observed
- Recommendations (what to fix, what to monitor)
- Appendix: key log excerpts and script outputs

Be precise - timestamps, counts, percentages, specific log lines. The report's
severity counts must match `severity_index`.

Write the complete draft into `report_draft` (context_write) - the verify
stage that follows fact-checks that draft line by line, and it cannot start
until the draft is there. Also write the report file (write_file) if the task
asked for one on disk.

Evidence conduct, applying to everything you produce:
- Cite the source of every factual claim (file and line, log entry,
  or document section) so a reader can check it without you.
- Keep a running record of key findings together with their sources as
  you work, and reuse that record instead of trusting memory.
- If the available material does not establish something you need, ask
  for it when you have a way to ask; otherwise state the gap explicitly.
  Never fill a gap with what similar systems usually do - an unsupported
  guess presented as fact is worse than a missing value.
"""

# Stage-scoped layout: this stage sees what its job needs and
# nothing else. The rest are parked, not dropped - a later stage
# that declares them gets them back with their content. Every
# region this stage routes tool output into is declared here;
# routing into a parked region is a dead drop (make_scoped.py
# refuses to generate one).
# Budgets sum to 91% of this stage's window.
[stages.report.context.regions]
task = { kind = "pinned", volatility = "stable", budget = "5%", min_tokens = 4000, required = true, seed = "task", required_message = "Name the log file(s)/dir and what to look for via --task." }
severity_index = { kind = "pinned", volatility = "grows", budget = "3%", summarizable = false }
findings = { kind = "sliding_window", volatility = "grows", max_items = 30, budget = "20%", strategy = "bulk", overflow = 10, summarizable = false }
logs = { kind = "temporary", volatility = "grows", budget = "20%" }
report_draft = { kind = "pinned", volatility = "grows", budget = "20%", summarizable = false }
conversation = { kind = "sliding_window", volatility = "grows", max_items = 30, budget = "20%", strategy = "bulk", overflow = 10 }
error_report = { kind = "pinned", volatility = "grows", budget = "3%" }

[stages.report.transitions.verify]
hint = "The draft is written - fact-check it"
transform = "custom"

# `custom`, not `compact`: a bare compact edge summarizes EVERY
# stage-specific region, `results` included. Figures must cross
# an edge unchanged - only the conversation is safe to summarize.
[stages.report.transitions.verify.transform_config]
carry = []
compact = ["conversation"]
clear = []
compact_prompt = "Summarize the conversation so far, preserving every figure verbatim."

# The specific-question path skips the report machinery entirely.
[stages.report.transitions.summary]
hint = "The task asked only a specific question - no report to check"
transform = "custom"

[stages.report.transitions.summary.transform_config]
carry = []
compact = ["conversation"]
clear = []
compact_prompt = "Summarize the conversation so far, preserving every figure verbatim."

# ─── Stage 4: Verify (fact-check the deliverable) ─────────────────────────────
# The critic upstream attacks the ANALYSIS; nothing attacked the report -
# and the measured failure mode of this pipeline is a complete,
# well-formatted report whose facts are misattributed or filled from
# prior. This stage closes that gap: every factual line of the draft is
# re-established against the files on disk before the answer ships.
[stages.verify]
mode = "autonomous"
model = { models = [{ provider = "anthropic", model = "claude-sonnet-5" }] }
description = "Fact-check every figure in the report draft against the sources"
available_tools = ["read_file", "list_dir", "context_write", "context_append"]
max_iterations = 25
# Checking the deliverable - don't inject mid-run user messages into it.
accepts_messages = false
system_prompt = """
The report draft in `report_draft` is claimed, not established. Fact-check it:

Triage first: rank the draft's factual claims by how load-bearing they are -
the values the deliverable is judged on before supporting color - and check in
that order, because your iteration budget may not cover everything. For each
claim - timestamp, count, rate, filename, field name, config key - re-open the
cited source (read_file) and confirm the value character for
character. Do not trust the draft, the findings, or your
memory of the logs: the whole point of this stage is that those can be wrong.
Keep a tally of confirmed/corrected/unchecked as you go.

Three fates, and the difference between the last two is the whole job:
- A value the source CONFIRMS stands.
- A value the source CONTRADICTS is corrected in the draft to what the source
  actually says, never to a compromise. A claim whose cited source, when
  opened, contains no support for it is removed - that is a contradiction.
- A claim you RAN OUT OF BUDGET to check is NOT removed. It keeps its
  original citation and stands as the investigation delivered it, counted in
  the unchecked tally. The investigation already did its work under the
  evidence conduct; destroying its sourced findings because you lacked time
  to re-derive them replaces a possible error with a certain one.

When the pass is complete, rewrite `report_draft` (context_write) with the
corrected draft, appending one line: `verify: N confirmed, N corrected,
N unchecked`. Precision beats speed on what you do check; coverage honesty
beats false completeness on what you do not.

Evidence conduct, applying to everything you produce:
- Cite the source of every factual claim (file and line, log entry,
  or document section) so a reader can check it without you.
- Keep a running record of key findings together with their sources as
  you work, and reuse that record instead of trusting memory.
- If the available material does not establish something you need, ask
  for it when you have a way to ask; otherwise state the gap explicitly.
  Never fill a gap with what similar systems usually do - an unsupported
  guess presented as fact is worse than a missing value.
"""

[stages.verify.tool_routing]
# No single tool result may fill the region it lands in.
max_result_tokens = 4000
default_region = "conversation"
[stages.verify.tool_routing.overrides]
read_file = { region = "logs", max_result_tokens = 16000 }

# Stage-scoped layout: this stage sees what its job needs and
# nothing else. The rest are parked, not dropped - a later stage
# that declares them gets them back with their content. Every
# region this stage routes tool output into is declared here;
# routing into a parked region is a dead drop (make_scoped.py
# refuses to generate one).
# Budgets sum to 97% of this stage's window.
[stages.verify.context.regions]
task = { kind = "pinned", volatility = "stable", budget = "4%", min_tokens = 4000, required = true, seed = "task", required_message = "Name the log file(s)/dir and what to look for via --task." }
severity_index = { kind = "pinned", volatility = "grows", budget = "3%", summarizable = false }
findings = { kind = "sliding_window", volatility = "grows", max_items = 30, budget = "20%", strategy = "bulk", overflow = 10, summarizable = false }
logs = { kind = "temporary", volatility = "grows", budget = "25%" }
report_draft = { kind = "pinned", volatility = "grows", budget = "20%", summarizable = false, required = true }
conversation = { kind = "sliding_window", volatility = "grows", max_items = 30, budget = "18%", strategy = "bulk", overflow = 10 }
scratch = { kind = "clearable", budget = "4%" }
error_report = { kind = "pinned", volatility = "grows", budget = "3%" }

[stages.verify.transitions.summary]
hint = "The draft is checked - deliver it"
transform = "custom"

[stages.verify.transitions.summary.transform_config]
carry = []
compact = ["conversation"]
clear = []
compact_prompt = "Summarize what was checked and what changed: counts of confirmed, corrected and removed claims, with every corrected figure verbatim."

[stages.verify.transitions.error_recovery]
condition = "error"
transform = "direct"

# ─── Stage 5: Error recovery ──────────────────────────────────────────────────
[stages.error_recovery]
mode = "autonomous"
model = { models = [{ provider = "anthropic", model = "claude-opus-5" }] }
description = "Recover from a failed read or script execution"
available_tools = ["read_file", "list_dir", "context_write", "context_append"]
max_iterations = 10
max_revisits = 1
system_prompt = """
A read or script execution failed. The `error_report` region holds the error
text the runtime captured - read it first, diagnose it (a malformed log line, a
script bug, a missing file), note a workaround, then return to analyze to
continue with the data available.

Evidence conduct, applying to everything you produce:
- Cite the source of every factual claim (file and line, log entry,
  or document section) so a reader can check it without you.
- Keep a running record of key findings together with their sources as
  you work, and reuse that record instead of trusting memory.
- If the available material does not establish something you need, ask
  for it when you have a way to ask; otherwise state the gap explicitly.
  Never fill a gap with what similar systems usually do - an unsupported
  guess presented as fact is worse than a missing value.
"""

# Un-exhaustible escape (lint: dead-end-possible): when every looping
# target has spent its max_revisits budget, the run can still move forward
# to the deliverable instead of dead-ending.
# Stage-scoped layout: this stage sees what its job needs and
# nothing else. The rest are parked, not dropped - a later stage
# that declares them gets them back with their content. Every
# region this stage routes tool output into is declared here;
# routing into a parked region is a dead drop (make_scoped.py
# refuses to generate one).
# Budgets sum to 92% of this stage's window.
[stages.error_recovery.context.regions]
task = { kind = "pinned", volatility = "stable", budget = "4%", min_tokens = 4000, required = true, seed = "task", required_message = "Name the log file(s)/dir and what to look for via --task." }
findings = { kind = "sliding_window", volatility = "grows", max_items = 30, budget = "20%", strategy = "bulk", overflow = 10, summarizable = false }
logs = { kind = "temporary", volatility = "grows", budget = "20%" }
report_draft = { kind = "pinned", volatility = "grows", budget = "12%", summarizable = false }
conversation = { kind = "sliding_window", volatility = "grows", max_items = 30, budget = "24%", strategy = "bulk", overflow = 10 }
scratch = { kind = "clearable", budget = "4%" }
error_report = { kind = "pinned", volatility = "grows", budget = "8%" }

[stages.error_recovery.transitions.report]
hint = "Recovery is not converging - report the findings so far"
transform = "custom"

# `custom`, not `compact`: a bare compact edge summarizes EVERY
# stage-specific region, `results` included. Figures must cross
# an edge unchanged - only the conversation is safe to summarize.
[stages.error_recovery.transitions.report.transform_config]
carry = []
compact = ["conversation"]
clear = []
compact_prompt = "Summarize the conversation so far, preserving every figure verbatim."

[stages.error_recovery.transitions.analyze]
hint = "Recovered - resume analysis"
transform = "custom"

# `custom`, not `compact`: a bare compact edge summarizes EVERY
# stage-specific region, `results` included. Figures must cross
# an edge unchanged - only the conversation is safe to summarize.
[stages.error_recovery.transitions.analyze.transform_config]
carry = []
compact = ["conversation"]
clear = []
compact_prompt = "Summarize the conversation so far, preserving every figure verbatim."

[compaction]
provider = "anthropic"
model = "claude-sonnet-5"

# ─── Final output ────────────────────────────────────────────────────────────
# Terminal. `mode = "output"` grants `submit_output`, requires the call, and
# lets the run end here. No file tools on purpose: this stage reports, it does
# not work.
[stages.summary]
mode = "output"
model = { models = [{ provider = "openai", model = "gpt-5.6-luna" }] }
description = "Say what the logs showed"
# Reporting an answer is one call. The budget covers a retry -
# a schema refusal handed back, a format corrected - not a loop:
# an unbounded output stage bills its whole context per attempt.
max_iterations = 5
system_prompt = """
Answer whoever asked, in the form they asked for.

If the task states an exact output format - a required final line, a particular
shape, "reply with only X" - reproduce it literally, with nothing wrapped around
it. An answer that is right but not in the requested form is unusable by whoever
asked, so it is not an answer.

If `task` asked a specific question, give that answer and nothing else - no
preamble, no report text, no restating the question. If it asked for an analysis
or a report, deliver from `report_draft` - it holds the fact-checked draft, and
its figures supersede anything the conversation remembers differently. Lead with
the diagnosis and how confident you are, then the evidence, then anything that
could not be established, and name the report file if one was written.

If you found nothing conclusive, say that plainly rather than dressing up a
guess.

Evidence conduct, applying to everything you produce:
- Cite the source of every factual claim (file and line, log entry,
  or document section) so a reader can check it without you.
- Keep a running record of key findings together with their sources as
  you work, and reuse that record instead of trusting memory.
- If the available material does not establish something you need, ask
  for it when you have a way to ask; otherwise state the gap explicitly.
  Never fill a gap with what similar systems usually do - an unsupported
  guess presented as fact is worse than a missing value.
"""

# Stage-scoped layout: this stage sees what its job needs and
# nothing else. The rest are parked, not dropped - a later stage
# that declares them gets them back with their content. Every
# region this stage routes tool output into is declared here;
# routing into a parked region is a dead drop (make_scoped.py
# refuses to generate one).
# Budgets sum to 96% of this stage's window.
[stages.summary.context.regions]
task = { kind = "pinned", volatility = "stable", budget = "8%", min_tokens = 4000, required = true, seed = "task", required_message = "Name the log file(s)/dir and what to look for via --task." }
severity_index = { kind = "pinned", volatility = "grows", budget = "5%", summarizable = false }
findings = { kind = "sliding_window", volatility = "grows", max_items = 30, budget = "25%", strategy = "bulk", overflow = 10, summarizable = false }
report_draft = { kind = "pinned", volatility = "grows", budget = "20%", summarizable = false }
conversation = { kind = "sliding_window", volatility = "grows", max_items = 30, budget = "35%", strategy = "bulk", overflow = 10 }
error_report = { kind = "pinned", volatility = "grows", budget = "3%" }

[stages.summary.transitions]

# ─── Context layout ───────────────────────────────────────────────────────────
[context.regions]
task            = { kind = "pinned", volatility = "stable", budget = "2%", min_tokens = 4000, required = true, seed = "task", required_message = "Name the log file(s)/dir and what to look for via --task." }
severity_index  = { kind = "pinned", volatility = "grows", budget = "2%", summarizable = false }
findings        = { kind = "sliding_window", volatility = "grows", max_items = 30, budget = "8%", strategy = "bulk", overflow = 10, summarizable = false }

logs            = { kind = "temporary", volatility = "grows",       budget = "32%" }

# The deliverable draft: written by report, fact-checked line by line and
# rewritten by verify, delivered by summary. Pinned so it crosses every
# edge untouched; summarizable = false because a summarized report IS the
# failure mode this region exists to prevent.
report_draft    = { kind = "pinned", volatility = "grows", budget = "20%", summarizable = false }

conversation    = { kind = "sliding_window", volatility = "grows", max_items = 30, budget = "20%", strategy = "bulk", overflow = 10 }
scratch         = { kind = "clearable", budget = "4%" }

# Written by the RUNTIME on an abnormal stage ending (issue #154): a failed
# inference call's error text, or a note that a stage hit its iteration cap.
# Pinned so it survives the edge transform into the stage that acts on it.
error_report    = { kind = "pinned", volatility = "grows", budget = "2%" }

# The per-stage system prompt. Declared, the runtime keeps it at the END of
# the pinned block run; undeclared, it lands in the first pinned region
# (`task`) and rewrites the head of the prompt every transition. Working
# stages also share one available_tools set: the tool array is hashed ahead
# of the system blocks, so differing sets invalidate the cache prefix.
stage_instructions = { kind = "pinned", volatility = "stable", budget = "3%", max_tokens = 4000 }

[stages.report.tool_routing]
[stages.report.tool_routing.overrides]
read_file = { max_result_tokens = 16000 }
read_files = { max_result_tokens = 16000 }

[stages.error_recovery.tool_routing]
[stages.error_recovery.tool_routing.overrides]
read_file = { max_result_tokens = 16000 }
read_files = { max_result_tokens = 16000 }
