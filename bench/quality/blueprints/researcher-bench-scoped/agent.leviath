# Stage-scoped variant of researcher-bench: identical stages, prompts
# and models; each stage declares only the regions it uses.
# GENERATED by make_scoped.py - regenerate rather than editing.

[agent]
name = "researcher"
version = "0.4.0-scoped"
description = "Research assistant - gather, analyze, and summarize with a gather↔analyze refinement loop and error recovery"
entry_stage = "gather"

# Read/search agent: it gathers and synthesizes, writing only its final report.
[tool_permissions]
read_file  = "allow"
list_dir   = "allow"
web_search = "allow"
web_fetch  = "allow"
write_file = "ask"
bash       = "ask"

# ─── Stage 1: Gather ──────────────────────────────────────────────────────────
[stages.gather]
mode = "autonomous"
model = { models = [{ provider = "anthropic", model = "claude-sonnet-5" }] }
description = "Gather relevant information on the topic"
# web_search / web_fetch are provided by the agent's script tools (issue #97).
available_tools = ["web_search", "web_fetch", "read_file", "list_dir", "bash", "write_file", "context_write", "context_append"]
max_iterations = 20
max_revisits = 2
system_prompt = """
You are gathering source material on the topic in the `query` region, within any
bounds set in `scope`.

Be efficient - do not search exhaustively:
1. Run a FOCUSED first round of 3-5 web_search calls covering the distinct
   sub-topics of the question (not many rephrasings of the same query).
2. web_fetch only the 2-3 most promising sources for detail; the search snippets
   in `raw_findings` are usually enough on their own.
3. As you go, append one bibliography line per source you actually use to the
   `sources_index` region with context_append:
   `[n] <title> - <url or path> - credibility: <high/med/low + why>`.

Prefer primary sources and well-established outlets; note when something is a blog,
forum, or vendor claim. Once you have solid coverage of the sub-topics, transition
to analyze - don't keep searching for marginal additions. The analyze stage will
send you back if it finds a real gap.
"""

[stages.gather.tool_routing]
# No single tool result may fill the region it lands in.
max_result_tokens = 6000
default_region = "raw_findings"

# Stage-scoped layout: this stage sees what its job needs and
# nothing else. The rest are parked, not dropped - a later stage
# that declares them gets them back with their content. Every
# region this stage routes tool output into is declared here;
# routing into a parked region is a dead drop (make_scoped.py
# refuses to generate one).
# Budgets sum to 95% of this stage's window.
[stages.gather.context.regions]
query = { kind = "pinned", budget = "2%", required = true, seed = "task", required_message = "State the research question via --task." }
scope = { kind = "pinned", budget = "2%", seed = "scope" }
sources_index = { kind = "pinned", budget = "5%", summarizable = false }
raw_findings = { kind = "temporary", budget = "56%" }
conversation = { kind = "sliding_window", max_items = 30, budget = "28%", strategy = "bulk", overflow = 10 }
error_report = { kind = "pinned", budget = "2%" }

[stages.gather.transitions.analyze]
hint = "Enough gathered for a first pass of analysis"
transform = "direct"

# Reachable only when every normal route is spent - a
# conditioned edge is never offered to the model, so this is an
# escape and not a shortcut. Without it the run would end with
# its work discarded rather than reported.
[stages.gather.transitions.summary]
condition = "dead_end"
hint = "No route left - report what has been established"
transform = "custom"

# `custom`, not `compact`: a bare compact edge summarizes EVERY
# stage-specific region, `results` included. Figures must cross
# an edge unchanged - only the conversation is safe to summarize.
[stages.gather.transitions.summary.transform_config]
carry = []
compact = ["conversation"]
clear = []
compact_prompt = "Summarize the conversation so far, preserving every figure verbatim."

[stages.gather.transitions.error_recovery]
condition = "error"
transform = "direct"

# ─── Stage 2: Analyze ─────────────────────────────────────────────────────────
# Two open edges (gather / summarize) → the LLM decides via transition_prompt
# whether it needs more sources or is ready to summarize.
[stages.analyze]
mode = "autonomous"
model = { models = [{ provider = "anthropic", model = "claude-opus-5" }] }
description = "Analyze and synthesize findings"
available_tools = ["web_search", "web_fetch", "read_file", "list_dir", "bash", "write_file", "context_write", "context_append"]
max_iterations = 30
max_revisits = 3
transition_prompt = """
You've analyzed the material gathered so far. Decide what happens next:
- If there are clear gaps you can't fill from what you have, respond with: gather
- If the task asked a specific question and the claims answer it, respond with: summary
- If the task asked for a written report or a survey of a topic, respond with: summarize
"""
system_prompt = """
Analyze the `raw_findings` against the `sources_index`. Do three things:

1. Extract factual claims into the `claims` region (context_append), each with its
   source reference: `<claim> [n]`. These are what the summary is built from.
2. When sources DISAGREE, record the conflict in `contradictions` (context_write)
   - who claims what, with source refs. Don't silently pick a side; surface it.
3. Judge strength: separate well-supported claims (multiple credible sources) from
   single-source or speculative ones.

Use web_fetch for a targeted follow-up only when a specific gap blocks a claim.
Flag open questions you couldn't resolve.

If `error_report` says a previous stage hit its iteration cap, that stage was cut
off before finishing - treat its output as incomplete and verify coverage before
concluding.
"""

[stages.analyze.tool_routing]
# No single tool result may fill the region it lands in.
max_result_tokens = 4000
default_region = "raw_findings"

# Stage-scoped layout: this stage sees what its job needs and
# nothing else. The rest are parked, not dropped - a later stage
# that declares them gets them back with their content. Every
# region this stage routes tool output into is declared here;
# routing into a parked region is a dead drop (make_scoped.py
# refuses to generate one).
# Budgets sum to 96% of this stage's window.
[stages.analyze.context.regions]
query = { kind = "pinned", budget = "3%", required = true, seed = "task", required_message = "State the research question via --task." }
scope = { kind = "pinned", budget = "2%", seed = "scope" }
sources_index = { kind = "pinned", budget = "6%", summarizable = false }
format = { kind = "pinned", budget = "2%", seed = { literal = "Cite every non-obvious claim as [n], matching a numbered entry in the Sources bibliography (title + URL/path). Mark each finding's confidence as high / medium / low based on source count and credibility." } }
raw_findings = { kind = "temporary", budget = "40%" }
claims = { kind = "sliding_window", max_items = 30, budget = "14%", summarizable = false, required = true }
contradictions = { kind = "clearable", budget = "4%" }
conversation = { kind = "sliding_window", max_items = 30, budget = "22%", strategy = "bulk", overflow = 10 }
error_report = { kind = "pinned", budget = "3%" }

[stages.analyze.transitions.gather]
hint = "More information needed on specific sub-topics"
transform = "custom"

# `custom`, not `compact`: a bare compact edge summarizes EVERY
# stage-specific region, `results` included. Figures must cross
# an edge unchanged - only the conversation is safe to summarize.
[stages.analyze.transitions.gather.transform_config]
carry = []
compact = ["conversation"]
clear = []
compact_prompt = "Summarize the conversation so far, preserving every figure verbatim."

# The deliverable follows the request: a written report when one was asked
# for, otherwise the answer to the question that was asked.
[stages.analyze.transitions.summary]
hint = "The task asked a specific question and the claims answer it"
transform = "custom"

# `custom`, not `compact`: a bare compact edge summarizes EVERY
# stage-specific region, `results` included. Figures must cross
# an edge unchanged - only the conversation is safe to summarize.
[stages.analyze.transitions.summary.transform_config]
carry = []
compact = ["conversation"]
clear = []
compact_prompt = "Summarize the conversation so far, preserving every figure verbatim."

[stages.analyze.transitions.summarize]
hint = "The task asked for a written report or a survey of a topic"
transform = "custom"

# `custom`, not `compact`: a bare compact edge summarizes EVERY
# stage-specific region, `results` included. Figures must cross
# an edge unchanged - only the conversation is safe to summarize.
[stages.analyze.transitions.summarize.transform_config]
carry = []
compact = ["conversation"]
clear = []
compact_prompt = "Summarize the conversation so far, preserving every figure verbatim."

[stages.analyze.transitions.error_recovery]
condition = "error"
transform = "direct"

# ─── Stage 3: Summarize (terminal) ────────────────────────────────────────────
[stages.summarize]
mode = "autonomous"
model = { models = [{ provider = "anthropic", model = "claude-sonnet-5" }] }
description = "Create a concise, well-organized summary"
available_tools = ["web_search", "web_fetch", "read_file", "list_dir", "bash", "write_file", "context_write", "context_append"]
max_iterations = 12
system_prompt = """
Check `task` first. If it only asked a specific question, writing a report is
work nobody asked for: do not write one, and move to summary with the answer.

Otherwise the task asked for a written report, so write one.

Write the research report (write_file), built from the `claims` region and citing
`sources_index`. Follow the citation/confidence rules in the `format` region.

Structure:
- Key findings organized by theme, each with a confidence level.
- Notable disagreements - pull these straight from the `contradictions` region;
  never drop a recorded conflict.
- Open questions.
- Sources - the numbered bibliography from `sources_index`.

Keep it tight and skimmable. Every non-obvious claim must carry a [n] citation.
"""

# Stage-scoped layout: this stage sees what its job needs and
# nothing else. The rest are parked, not dropped - a later stage
# that declares them gets them back with their content. Every
# region this stage routes tool output into is declared here;
# routing into a parked region is a dead drop (make_scoped.py
# refuses to generate one).
# Budgets sum to 96% of this stage's window.
[stages.summarize.context.regions]
query = { kind = "pinned", budget = "4%", required = true, seed = "task", required_message = "State the research question via --task." }
sources_index = { kind = "pinned", budget = "8%", summarizable = false }
format = { kind = "pinned", budget = "3%", seed = { literal = "Cite every non-obvious claim as [n], matching a numbered entry in the Sources bibliography (title + URL/path). Mark each finding's confidence as high / medium / low based on source count and credibility." } }
claims = { kind = "sliding_window", max_items = 30, budget = "30%", summarizable = false }
contradictions = { kind = "clearable", budget = "8%" }
conversation = { kind = "sliding_window", max_items = 30, budget = "40%", strategy = "bulk", overflow = 10 }
error_report = { kind = "pinned", budget = "3%" }

[stages.summarize.transitions.summary]
hint = "The report is written"

# ─── Stage 4: Error recovery ──────────────────────────────────────────────────
[stages.error_recovery]
mode = "autonomous"
model = { models = [{ provider = "anthropic", model = "claude-sonnet-5" }] }
description = "Diagnose and recover from errors during gathering or analysis"
available_tools = ["web_search", "web_fetch", "read_file", "list_dir", "bash", "write_file", "context_write", "context_append"]
max_iterations = 8
max_revisits = 1
system_prompt = """
Something failed during research (a source fetch, a parse, etc.). The
`error_report` region holds the error text the runtime captured - read it first,
work out what went wrong, and note a workaround. Then hand back to analyze to
continue with whatever material is available.
"""

# Un-exhaustible escape (lint: dead-end-possible): when every looping
# target has spent its max_revisits budget, the run can still move forward
# to the deliverable instead of dead-ending.
# Stage-scoped layout: this stage sees what its job needs and
# nothing else. The rest are parked, not dropped - a later stage
# that declares them gets them back with their content. Every
# region this stage routes tool output into is declared here;
# routing into a parked region is a dead drop (make_scoped.py
# refuses to generate one).
# Budgets sum to 93% of this stage's window.
[stages.error_recovery.context.regions]
query = { kind = "pinned", budget = "3%", required = true, seed = "task", required_message = "State the research question via --task." }
sources_index = { kind = "pinned", budget = "5%", summarizable = false }
raw_findings = { kind = "temporary", budget = "32%" }
conversation = { kind = "sliding_window", max_items = 30, budget = "45%", strategy = "bulk", overflow = 10 }
error_report = { kind = "pinned", budget = "8%" }

[stages.error_recovery.transitions.summary]
hint = "Recovery is not converging - answer from what was found"
transform = "custom"

# `custom`, not `compact`: a bare compact edge summarizes EVERY
# stage-specific region, `results` included. Figures must cross
# an edge unchanged - only the conversation is safe to summarize.
[stages.error_recovery.transitions.summary.transform_config]
carry = []
compact = ["conversation"]
clear = []
compact_prompt = "Summarize the conversation so far, preserving every figure verbatim."

[stages.error_recovery.transitions.analyze]
hint = "Recovered - continue analysis"
transform = "custom"

# `custom`, not `compact`: a bare compact edge summarizes EVERY
# stage-specific region, `results` included. Figures must cross
# an edge unchanged - only the conversation is safe to summarize.
[stages.error_recovery.transitions.analyze.transform_config]
carry = []
compact = ["conversation"]
clear = []
compact_prompt = "Summarize the conversation so far, preserving every figure verbatim."

[compaction]
provider = "anthropic"
model = "claude-sonnet-5"

# ─── Final output ────────────────────────────────────────────────────────────
# Terminal. `mode = "output"` grants `submit_output`, requires the call, and
# lets the run end here. No file tools on purpose: this stage reports, it does
# not work.
[stages.summary]
mode = "output"
model = { models = [{ provider = "anthropic", model = "claude-sonnet-5" }] }
description = "Say what the research found"
# Reporting an answer is one call. The budget covers a retry -
# a schema refusal handed back, a format corrected - not a loop:
# an unbounded output stage bills its whole context per attempt.
max_iterations = 5
system_prompt = """
Answer whoever asked, in the form they asked for.

If the task states an exact output format - a required final line, a particular
shape, "reply with only X" - reproduce it literally, with nothing wrapped around
it. An answer that is right but not in the requested form is unusable by whoever
asked, so it is not an answer.

If `task` asked a specific question, give that answer and nothing else - no
preamble, no citations list, no restating the question. If it asked for a survey
or a report, lead with the answer in two or three sentences, then the two or
three findings that matter most with their confidence levels, and name the report
file if you wrote one.

Do not re-derive anything or re-list every source. This is what someone reads
instead of the report, not a second copy of it.
"""

# Stage-scoped layout: this stage sees what its job needs and
# nothing else. The rest are parked, not dropped - a later stage
# that declares them gets them back with their content. Every
# region this stage routes tool output into is declared here;
# routing into a parked region is a dead drop (make_scoped.py
# refuses to generate one).
# Budgets sum to 95% of this stage's window.
[stages.summary.context.regions]
query = { kind = "pinned", budget = "6%", required = true, seed = "task", required_message = "State the research question via --task." }
claims = { kind = "sliding_window", max_items = 30, budget = "32%", summarizable = false }
conversation = { kind = "sliding_window", max_items = 30, budget = "54%", strategy = "bulk", overflow = 10 }
error_report = { kind = "pinned", budget = "3%" }

[stages.summary.transitions]

# ─── Context layout ───────────────────────────────────────────────────────────
# Budgets are a percentage of the model's context window (issue #100) with an
# absolute `max_tokens`/`threshold_tokens` guard-rail. Percentages are ceilings.
[context.regions]
# The research question - required. Supplied via --task (or the API/ACP task field).
query          = { kind = "pinned", budget = "1%", required = true, seed = "task", required_message = "State the research question via --task." }
# Optional caller bounds: --scope "peer-reviewed sources since 2020 only".
scope          = { kind = "pinned", budget = "1%", seed = "scope" }
# Growing bibliography with credibility notes (curated by the agent).
sources_index  = { kind = "pinned", budget = "3%", summarizable = false }
# Citation/confidence rules (seeded with a sensible default the agent follows).
format         = { kind = "pinned", budget = "1%", seed = { literal = "Cite every non-obvious claim as [n], matching a numbered entry in the Sources bibliography (title + URL/path). Mark each finding's confidence as high / medium / low based on source count and credibility." } }

# Raw source material (bulk, evictable).
raw_findings   = { kind = "temporary", budget = "38%" }
# Extracted claims (with source refs) and cross-source conflicts.
claims         = { kind = "sliding_window", max_items = 30, budget = "10%", summarizable = false }
contradictions = { kind = "clearable",      budget = "3%" }

# Synthesis workspace (compacts to a running history when it grows).
synthesis         = { kind = "compacting",      budget = "12%", compact_at = "80%" }
synthesis_history = { kind = "compact_history", source_region = "synthesis", budget = "3%" }

# The message stream. An explicit sliding_window `conversation` region is required -
# the per-stage layout is rebuilt from this table on each transition, so an
# auto-added one would be dropped after the first stage.
conversation      = { kind = "sliding_window", max_items = 30, budget = "21%", strategy = "bulk", overflow = 10 }

# Written by the RUNTIME on an abnormal stage ending (issue #154): a failed
# inference call's error text, or a note that a stage hit its iteration cap.
# Pinned so it survives the edge transform into the stage that acts on it.
error_report      = { kind = "pinned", budget = "2%" }

# The per-stage system prompt. Declared, the runtime keeps it at the END of
# the pinned block run; undeclared, it lands in the first pinned region
# (`query`) and rewrites the head of the prompt every transition. Working
# stages also share one available_tools set: the tool array is hashed ahead
# of the system blocks, so differing sets invalidate the cache prefix.
stage_instructions = { kind = "pinned", budget = "3%", max_tokens = 4000 }
