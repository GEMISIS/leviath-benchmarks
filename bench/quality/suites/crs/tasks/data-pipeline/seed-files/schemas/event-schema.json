{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Event Schema",
  "description": "Schema for analytics events",
  "type": "object",
  "required": ["event_id", "event_type", "timestamp", "user_id"],
  "properties": {
    "event_id": {
      "type": "string",
      "pattern": "^evt_[a-zA-Z0-9]{16}$",
      "description": "Unique event identifier"
    },
    "event_type": {
      "type": "string",
      "enum": ["page_view", "click", "purchase", "signup", "login", "logout"],
      "description": "Type of event"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp"
    },
    "user_id": {
      "type": "integer",
      "minimum": 1,
      "description": "User identifier"
    },
    "session_id": {
      "type": "string",
      "description": "Session identifier (optional)"
    },
    "properties": {
      "type": "object",
      "description": "Event-specific properties",
      "additionalProperties": true
    },
    "device": {
      "type": "object",
      "properties": {
        "type": {"type": "string", "enum": ["desktop", "mobile", "tablet"]},
        "os": {"type": "string"},
        "browser": {"type": "string"}
      }
    }
  }
}
