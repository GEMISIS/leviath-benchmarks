# Copy to .env (git-ignored) and fill in. run_quality.py loads it, with
# the real environment winning over anything set here. Keys are never
# written into results - a secret scrub refuses to exit clean otherwise.

# Providers for the model roster in bench/quality/arms.json.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Web search for the research suites. Without it the agents' web_search
# tool falls back, silently, to Wikipedia-only results - so the runner
# refuses the GAIA suite unless it is set.
BRAVE_API_KEY=

# Gated dataset download for GAIA (accept the dataset terms first).
HF_TOKEN=
